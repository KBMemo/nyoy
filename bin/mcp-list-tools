#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/environment"

unless Mcp.enabled?
  warn "Nyoy MCP is disabled. Set MCP_API_TOKEN to enable."
  exit 1
end

web_budget = ChatTools::WebToolBudget.from_settings
server_context = {
  web_budget: web_budget,
  tool_instances: Mcp::ToolBridge.instances(web_budget: web_budget).index_by(&:name)
}

Mcp::ToolCatalog.tools(server_context: server_context).each do |tool|
  puts tool.name_value
end
