#!/usr/bin/env ruby

APP_ROOT = File.expand_path("..", __dir__)

def load_env_file(path)
  return unless File.exist?(path)

  File.foreach(path, chomp: true) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    next if key.nil? || value.nil?

    ENV[key] = value.delete_prefix('"').delete_suffix('"')
  end
end

load_env_file(File.join(APP_ROOT, "env.development"))
# turedure (3000) / tsuzura (3008) と被らない既定ポート。env.development で上書き可。
# Procfile.dev は web を先頭にする（Foreman は 2 番目以降に PORT+100 を付ける）。
ENV["PORT"] ||= "3009"
ENV["VITE_RUBY_PORT"] ||= "3040"

# 接続は DB 優先のため、env.development の URL / トークンを起動時に反映する。
sync_ok = system(
  { "BUNDLE_GEMFILE" => File.join(APP_ROOT, "Gemfile") },
  "bundle", "exec", "rails", "runner", "ServiceConnectionSeeds.sync_from_env!",
  chdir: APP_ROOT
)
abort("service connections の同期に失敗しました（DB 接続を確認してください）") unless sync_ok

exec("bundle", "exec", "foreman", "start", "-f", "Procfile.dev", *ARGV, chdir: APP_ROOT)
