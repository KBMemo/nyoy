#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/environment"

def usage
  warn "Usage: bin/with-service-connection-url KEY TEMP_URL -- COMMAND [ARGS...]"
  warn "Example: bin/with-service-connection-url llama_server_qwen3vl_4b http://127.0.0.1:9 -- bin/mcp-call-tool run_image_understanding_graph '{}'"
end

begin
separator = ARGV.index("--")
if separator.nil? || separator < 2 || separator == ARGV.length - 1
  usage
  exit 1
end

key = ARGV[0].to_s
temporary_url = ARGV[1].to_s
command = ARGV[(separator + 1)..]

connection = ServiceConnection.resolve_seeded(key)
raise ActiveRecord::RecordNotFound, "Couldn't find ServiceConnection for key #{key.inspect}" unless connection
original_url = connection.base_url

begin
  connection.update!(base_url: temporary_url)
  warn "#{key} base_url temporarily set to #{connection.reload.base_url}"

  system(*command)
  status = $?
  exit(status&.exitstatus || 1)
ensure
  connection.update!(base_url: original_url)
  warn "#{key} base_url restored to #{connection.reload.base_url}"
end
rescue ActiveRecord::RecordInvalid => e
  warn e.record.errors.full_messages.join(", ")
  exit 1
rescue ActiveRecord::RecordNotFound => e
  warn e.message
  exit 1
end
