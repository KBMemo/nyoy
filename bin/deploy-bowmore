#!/usr/bin/env bash
set -euo pipefail

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEPLOY_HOST="${NYOY_DEPLOY_HOST:-bowmore}"
DEPLOY_PATH="${NYOY_DEPLOY_PATH:-/home/kensei/sites/nyoy}"
BRANCH="${NYOY_DEPLOY_BRANCH:-main}"
RUN_SEED=0
CHECK_ONLY=0

usage() {
  cat <<'EOF'
Usage: bin/deploy-bowmore [options]

Transfer a pushed commit to bowmore without repository credentials, then run
the server-side systemd deployment.

Options:
  --check       verify the local revision and remote deploy environment only
  --seed        run db:seed during deployment
  -h, --help    show this help

Environment:
  NYOY_DEPLOY_HOST      SSH host (default: bowmore)
  NYOY_DEPLOY_PATH      remote app path (default: /home/kensei/sites/nyoy)
  NYOY_DEPLOY_BRANCH    branch to deploy (default: main)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)
      CHECK_ONLY=1
      shift
      ;;
    --seed)
      RUN_SEED=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

cd "${APP_ROOT}"

if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "tracked files contain uncommitted changes" >&2
  exit 1
fi

git fetch origin "${BRANCH}"
revision="$(git rev-parse HEAD)"
remote_revision="$(git rev-parse "origin/${BRANCH}")"
if [[ "${revision}" != "${remote_revision}" ]]; then
  echo "HEAD ${revision} is not the pushed origin/${BRANCH} ${remote_revision}" >&2
  exit 1
fi

if [[ "${CHECK_ONLY}" -eq 1 ]]; then
  echo "local revision: ${revision}"
  ssh "${DEPLOY_HOST}" "cd '${DEPLOY_PATH}' && bin/deploy --check"
  exit 0
fi

bundle_file="$(mktemp --suffix=.bundle nyoy-deploy.XXXXXX)"
remote_bundle="/tmp/nyoy-deploy-${revision}.bundle"
trap 'rm -f "${bundle_file}"' EXIT

git bundle create "${bundle_file}" HEAD
scp "${bundle_file}" "${DEPLOY_HOST}:${remote_bundle}"

seed_option="--no-seed"
if [[ "${RUN_SEED}" -eq 1 ]]; then
  seed_option="--seed"
fi

ssh "${DEPLOY_HOST}" bash -s -- "${DEPLOY_PATH}" "${remote_bundle}" "${revision}" "${BRANCH}" "${seed_option}" <<'REMOTE_SCRIPT'
set -euo pipefail

deploy_path="$1"
bundle_file="$2"
revision="$3"
branch="$4"
seed_option="$5"
trap 'rm -f "${bundle_file}"' EXIT

cd "${deploy_path}"
unexpected_changes="$(git status --porcelain --untracked-files=no | awk '{print $2}' | grep -Ev '^(\.kamal/secrets|config/credentials\.yml\.enc)$' || true)"
if [[ -n "${unexpected_changes}" ]]; then
  echo "remote tracked files contain unexpected changes:" >&2
  echo "${unexpected_changes}" >&2
  exit 1
fi

git fetch "${bundle_file}" HEAD
if [[ "$(git rev-parse FETCH_HEAD)" != "${revision}" ]]; then
  echo "transferred revision does not match ${revision}" >&2
  exit 1
fi

git checkout "${branch}"
git merge --ff-only FETCH_HEAD
bin/deploy --skip-pull "${seed_option}"
REMOTE_SCRIPT
