#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "net/http"
require "uri"

def usage
  warn "Usage: bin/mcp-call-tool [--raw] [--field FIELD] TOOL_NAME [JSON_ARGUMENTS]"
  warn %q(Example: bin/mcp-call-tool run_image_understanding_graph '{"question":"この画像を説明して","tsuzura_media_id":"01J..."}')
end

begin
raw_output = ARGV.delete("--raw")
field_index = ARGV.index("--field")
field_name = nil
if field_index
  field_name = ARGV[field_index + 1].to_s
  if field_name.empty?
    warn "--field requires FIELD."
    exit 1
  end
  ARGV.slice!(field_index, 2)
end
tool_name = ARGV[0].to_s.strip
if tool_name.empty?
  usage
  exit 1
end

token = ENV["MCP_API_TOKEN"].to_s
if token.empty?
  warn "MCP_API_TOKEN is required."
  exit 1
end

arguments_json = ARGV[1].to_s.strip
arguments_json = "{}" if arguments_json.empty?

arguments = JSON.parse(arguments_json)
unless arguments.is_a?(Hash)
  warn "JSON_ARGUMENTS must be a JSON object."
  exit 1
end

url = ENV.fetch("NYOY_MCP_URL", "http://127.0.0.1:3109/mcp")
uri = URI.parse(url)
request = Net::HTTP::Post.new(uri)
request["Authorization"] = "Bearer #{token}"
request["Content-Type"] = "application/json"
request["Accept"] = "application/json"
request.body = JSON.generate(
  jsonrpc: "2.0",
  id: 1,
  method: "tools/call",
  params: {
    name: tool_name,
    arguments: arguments
  }
)

http = Net::HTTP.new(uri.host, uri.port)
http.use_ssl = uri.scheme == "https"
response = http.request(request)

begin
  payload = JSON.parse(response.body)
  text_payload = payload.dig("result", "content", 0, "text")
  output_payload = raw_output || text_payload.to_s.empty? ? payload : JSON.parse(text_payload)
  if field_name
    unless output_payload.is_a?(Hash) && output_payload.key?(field_name)
      warn "Field not found: #{field_name}"
      exit 1
    end
    value = output_payload[field_name]
    puts(value.is_a?(Hash) || value.is_a?(Array) ? JSON.generate(value) : value)
  else
    puts JSON.pretty_generate(output_payload)
  end
rescue JSON::ParserError
  puts response.body
end

exit(response.is_a?(Net::HTTPSuccess) ? 0 : 1)
rescue JSON::ParserError => e
  warn "Invalid JSON_ARGUMENTS: #{e.message}"
  exit 1
rescue URI::InvalidURIError => e
  warn "Invalid NYOY_MCP_URL: #{e.message}"
  exit 1
end
