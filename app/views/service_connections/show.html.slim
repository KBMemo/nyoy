- content_for :title, @service_connection.name

.mb-6.flex.flex-wrap.items-center.justify-between.gap-3
  h1 class=kb_page_title = @service_connection.name
  .flex.flex-wrap.items-center.gap-3
    = button_to "モデル取得", refresh_models_service_connection_path(@service_connection), method: :post, class: kb_btn_secondary_sm
    = link_to "編集", edit_service_connection_path(@service_connection), class: kb_btn_secondary_sm

.kb-card.p-4.space-y-4
  dl.grid.gap-2.text-sm class="sm:grid-cols-[auto_1fr]"
    dt.font-medium.kb-text-secondary 種別
    dd = @service_connection.key_label
    dt.font-medium.kb-text-secondary key
    dd.nyoy-monospace = @service_connection.key
    dt.font-medium.kb-text-secondary URL
    dd.nyoy-monospace = @service_connection.base_url
    - if @service_connection.server_model.present?
      dt.font-medium.kb-text-secondary モデル
      dd.nyoy-monospace = @service_connection.server_model
    - else
      dt.font-medium.kb-text-secondary モデル
      dd.kb-text-muted 未設定（「モデル取得」で接続先 API から取得できます）
    - if @service_connection.api_token.present?
      dt.font-medium.kb-text-secondary API トークン
      dd.nyoy-monospace ••••••••
    dt.font-medium.kb-text-secondary 状態
    dd = @service_connection.enabled? ? "有効" : "無効"
    dt.font-medium.kb-text-secondary 表示順
    dd = @service_connection.sort_order
    - if @service_connection.searxng?
      - searx = @service_connection.searxng_settings
      dt.font-medium.kb-text-secondary 取得件数
      dd = searx.result_count
      dt.font-medium.kb-text-secondary 同時検索数
      dd = searx.concurrent_searches
      dt.font-medium.kb-text-secondary fetch_url 同時取得数
      dd = searx.concurrent_fetches
      dt.font-medium.kb-text-secondary リトライ
      dd = searx.retry_count
      dt.font-medium.kb-text-secondary web_search 上限
      dd = "#{searx.max_searches_per_turn} 回 / 応答"
      dt.font-medium.kb-text-secondary fetch_url 上限
      dd = "#{searx.max_fetches_per_turn} 回 / 応答"
      dt.font-medium.kb-text-secondary 検索エンジン
      dd.nyoy-monospace = searx.engines
    - if @service_connection.supports_prompt_conversion_settings?
      - pcs = @service_connection.prompt_conversion_settings
      dt.font-medium.kb-text-secondary JSON Schema
      dd = { "auto" => "自動", "on" => "強制オン", "off" => "オフ" }.fetch(pcs.json_schema, pcs.json_schema)
      dt.font-medium.kb-text-secondary enable_thinking
      dd = { "false" => "オフ", "true" => "オン", "unset" => "未指定" }.fetch(pcs.enable_thinking, pcs.enable_thinking)
      dt.font-medium.kb-text-secondary サンプリング
      dd
        .flex.flex-wrap.gap-x-3.gap-y-1.font-mono.text-xs
          - LlmSamplingParams::KEYS.each do |key|
            span
              span.kb-text-muted = "#{key}="
              = pcs.public_send(key).nil? ? "—" : pcs.public_send(key)
    - if @service_connection.openai?
      - chat_settings = @service_connection.openai_chat_model_settings
      dt.font-medium.kb-text-secondary Chat モデル
      dd
        - if chat_settings.catalog.any?
          = form_with url: openai_chat_models_service_connection_path(@service_connection), method: :patch, class: "space-y-3" do
            - chat_settings.grouped_catalog.each do |group_name, model_ids|
              .space-y-1
                p.text-xs.font-medium.kb-text-muted = group_name
                ul.space-y-1.pl-1
                  - model_ids.each do |model_id|
                    li
                      label.flex.items-center.gap-2.text-sm
                        = check_box_tag "service_connection[openai_chat_models][enabled][#{model_id}]", "1", chat_settings.enabled?(model_id), class: "kb-control-accent"
                        span.nyoy-monospace = model_id
            button type="submit" class=kb_btn_secondary_sm Chat モデルを更新
        - else
          span.kb-text-muted 「モデル取得」で OpenAI から同期してください
  - if @service_connection.notes.present?
    div
      h2 class=kb_section_title メモ
      p.mt-2.text-sm.kb-text-secondary.whitespace-pre-wrap = @service_connection.notes

.mt-4
  = link_to "一覧へ戻る", service_connections_path, class: "kb-chrome-link text-sm"
