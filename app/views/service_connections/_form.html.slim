- content_for :title, title
- custom_llm = @custom_llm || service_connection.custom_llm?

.mb-6
  h1 class=kb_page_title = title

= form_with model: service_connection, class: "space-y-4 max-w-3xl" do |form|
  - if custom_llm && !service_connection.persisted?
    input type="hidden" name="custom" value="1"
  - if service_connection.errors.any?
    .kb-alert.kb-alert-danger
      ul.list-disc.pl-5
        - service_connection.errors.full_messages.each do |message|
          li = message

  div
    = form.label :key, "key（内部識別子）", class: "#{kb_label} mb-1"
    - if service_connection.persisted?
      p.nyoy-monospace.text-sm.kb-text-secondary = service_connection.key
      p.mt-1.text-sm.kb-text-muted key は変更できません。
    - elsif custom_llm
      = form.text_field :key, required: true, class: kb_field_input_classes, placeholder: "llm_balvenie_10012"
      p.mt-1.text-sm.kb-text-muted
        | llama-server 互換 API 用。必ず
        code llm_
        |  で始め、小文字英数字と _ のみ。Chat・画像プロンプト変換の選択肢に出ます。
    - else
      - available_keys = @available_keys || ServiceConnection.available_keys
      - if available_keys.any?
        = form.select :key, available_keys.map { |key| [ServiceConnection::KEY_LABELS.fetch(key, key), key] }, { prompt: "選択してください" }, required: true, class: kb_field_input_classes
      - else
        p.text-sm.kb-text-muted 未登録の組み込み key がありません。
        = link_to "カスタム LLM を追加", new_service_connection_path(custom: 1), class: "kb-chrome-link text-sm"

  div
    = form.label :name, "表示名", class: "#{kb_label} mb-1"
    = form.text_field :name, required: true, class: kb_field_input_classes

  div
    = form.label :base_url, "URL", class: "#{kb_label} mb-1"
    = form.url_field :base_url, required: true, class: kb_field_input_classes, placeholder: "http://balvenie:10010"

  div
    = form.label :server_model, custom_llm ? "モデル名" : "モデル名（任意）", class: "#{kb_label} mb-1"
    - model_options = Array(@model_options)
    - if model_options.any?
      - choices = model_options.map { |model| [model, model] }
      - if service_connection.server_model.present? && !model_options.include?(service_connection.server_model)
        - choices.unshift(["#{service_connection.server_model}（現在の設定）", service_connection.server_model])
      = form.select :server_model, choices, (custom_llm ? {} : { include_blank: "選択しない" }), class: kb_field_input_classes, required: custom_llm
      p.mt-1.text-sm.kb-text-muted 接続先 API から取得したモデル候補です。
    - else
      = form.text_field :server_model, class: kb_field_input_classes, placeholder: "llama-server のモデル alias", required: custom_llm
      p.mt-1.text-sm.kb-text-muted llama-server / 埋め込み API のモデル名。編集画面の「モデル取得」でも候補を取得できます。
    - if @model_options_error.present?
      p.mt-1.text-sm.kb-text-muted = "モデル候補を取得できませんでした: #{@model_options_error}"

  - unless custom_llm
    div
      = form.label :api_token, "API トークン（任意）", class: "#{kb_label} mb-1"
      = form.password_field :api_token, class: kb_field_input_classes, autocomplete: "off"
      - if service_connection.key == "searfront"
        p.mt-1.text-sm.kb-text-muted searfront の Bearer トークン（必須）。空欄のまま更新すると既存のトークンは保持されます。
      - elsif service_connection.openai?
        p.mt-1.text-sm.kb-text-muted OpenAI API キー（sk-...）。有効化するには必須です。空欄のまま更新すると既存のキーは保持されます。
      - else
        p.mt-1.text-sm.kb-text-muted sd.cpp switchd や徒然 API の認証トークンなど。空欄のまま更新すると既存のトークンは保持されます。

  - if service_connection.searfront?
    - searx = service_connection.searfront_settings
    .kb-card.p-4.space-y-4
      h2 class=kb_section_title 検索設定
      p.text-sm.kb-text-muted 件数・同時実行・ツール上限を抑えてコンテキスト溢れを防ぎます。検索エンジンの選択・フォールバックは searfront 側が担います。
      .grid.gap-4 class="sm:grid-cols-2"
        div
          label class="#{kb_label} mb-1" for="service_connection_searfront_settings_result_count" 取得件数
          input#service_connection_searfront_settings_result_count.kb-input.kb-field-input type="number" name="service_connection[searfront_settings][result_count]" value=searx.result_count min=1 max=10 step=1
          p.mt-1.text-sm.kb-text-muted 推奨 3〜5。最大 10。
        div
          label class="#{kb_label} mb-1" for="service_connection_searfront_settings_concurrent_searches" 同時検索数
          input#service_connection_searfront_settings_concurrent_searches.kb-input.kb-field-input type="number" name="service_connection[searfront_settings][concurrent_searches]" value=searx.concurrent_searches min=1 max=3 step=1
          p.mt-1.text-sm.kb-text-muted 推奨 1。
        div
          label class="#{kb_label} mb-1" for="service_connection_searfront_settings_concurrent_fetches" fetch_url 同時取得数
          input#service_connection_searfront_settings_concurrent_fetches.kb-input.kb-field-input type="number" name="service_connection[searfront_settings][concurrent_fetches]" value=searx.concurrent_fetches min=1 max=3 step=1
          p.mt-1.text-sm.kb-text-muted 推奨 1。Readability / HTTP 取得の並行数。
        div
          label class="#{kb_label} mb-1" for="service_connection_searfront_settings_retry_count" リトライ回数
          input#service_connection_searfront_settings_retry_count.kb-input.kb-field-input type="number" name="service_connection[searfront_settings][retry_count]" value=searx.retry_count min=0 max=2 step=1
          p.mt-1.text-sm.kb-text-muted 推奨 0〜1。
        div
          label class="#{kb_label} mb-1" for="service_connection_searfront_settings_max_searches_per_turn" web_search 上限（応答あたり）
          input#service_connection_searfront_settings_max_searches_per_turn.kb-input.kb-field-input type="number" name="service_connection[searfront_settings][max_searches_per_turn]" value=searx.max_searches_per_turn min=1 max=5 step=1
          p.mt-1.text-sm.kb-text-muted 推奨 2。最大 5。
        div
          label class="#{kb_label} mb-1" for="service_connection_searfront_settings_max_fetches_per_turn" fetch_url 上限（応答あたり）
          input#service_connection_searfront_settings_max_fetches_per_turn.kb-input.kb-field-input type="number" name="service_connection[searfront_settings][max_fetches_per_turn]" value=searx.max_fetches_per_turn min=1 max=10 step=1
          p.mt-1.text-sm.kb-text-muted 推奨 3。fetch_url は結果を見てから1件ずつ実行されます。

  - if service_connection.supports_prompt_conversion_settings?
    - pcs = service_connection.prompt_conversion_settings
    - presets = @llm_sampling_presets || LlmSamplingPreset.enabled.ordered
    .kb-card.p-4.space-y-4 data-controller="prompt-conversion-settings" data-prompt-conversion-settings-load-url-value=(service_connection.persisted? ? load_sampling_service_connection_path(service_connection, format: :json) : "") data-prompt-conversion-settings-field-prefix-value="service_connection_prompt_conversion_settings"
      .flex.flex-wrap.items-start.justify-between.gap-3
        div
          h2 class=kb_section_title プロンプト変換 / チャット既定サンプリング
          p.mt-1.text-sm.kb-text-muted
            | この接続を使うチャットの既定サンプリングにも流します（チャット個別設定があればそちら優先）。画像生成のスタイル計画・DirectPrompt でも同じサンプリングを使います。
        .flex.flex-wrap.items-center.gap-2
          - if service_connection.persisted?
            button type="button" class=kb_btn_secondary_sm data-action="prompt-conversion-settings#loadFromServer" data-prompt-conversion-settings-target="loadButton" サーバーから読み込む
          = link_to "プリセット管理", llm_sampling_presets_path, class: "kb-chrome-link text-sm"
      p.text-sm.kb-status-success.hidden data-prompt-conversion-settings-target="status"
      p.text-sm.text-red-600.hidden data-prompt-conversion-settings-target="error"

      .grid.gap-3 class="sm:grid-cols-2"
        div class="sm:col-span-2"
          label class="#{kb_label} mb-1" for="prompt_conversion_preset_select" 推奨プリセット
          .flex.flex-wrap.items-center.gap-2
            select#prompt_conversion_preset_select.kb-input.kb-field-input data-prompt-conversion-settings-target="presetSelect"
              option value="" 選択してください
              - presets.each do |preset|
                option value=preset.id data-params=preset.prompt_conversion_attrs.to_json = preset.name
            button type="button" class=kb_btn_secondary_sm data-action="prompt-conversion-settings#applyPreset" 適用
          p.mt-1.text-sm.kb-text-muted フォームに流し込みます。接続への保存は下の「更新」で行います。

        div
          label class="#{kb_label} mb-1" for="service_connection_prompt_conversion_settings_json_schema" JSON Schema
          select#service_connection_prompt_conversion_settings_json_schema.kb-input.kb-field-input name="service_connection[prompt_conversion_settings][json_schema]"
            - [["自動（接続種別の既定）", "auto"], ["強制オン", "on"], ["オフ（プロンプト指示のみ）", "off"]].each do |label, value|
              option value=value selected=(pcs.json_schema == value) = label
        div
          label class="#{kb_label} mb-1" for="service_connection_prompt_conversion_settings_enable_thinking" enable_thinking
          select#service_connection_prompt_conversion_settings_enable_thinking.kb-input.kb-field-input name="service_connection[prompt_conversion_settings][enable_thinking]" data-prompt-conversion-settings-field="enable_thinking"
            - [["オフ（推奨）", "false"], ["オン", "true"], ["未指定（送信しない）", "unset"]].each do |label, value|
              option value=value selected=(pcs.enable_thinking == value) = label

      .mt-2
        p class="#{kb_label} mb-2" サンプリング
        .flex.flex-wrap.items-end.gap-x-3.gap-y-2
          - [[ "temperature", pcs.temperature, "0.2", "decimal" ], [ "top_p", pcs.top_p, nil, "decimal" ], [ "top_k", pcs.top_k, nil, "numeric" ], [ "min_p", pcs.min_p, nil, "decimal" ], [ "presence_penalty", pcs.presence_penalty, nil, "decimal" ], [ "frequency_penalty", pcs.frequency_penalty, nil, "decimal" ], [ "repeat_penalty", pcs.repeat_penalty, nil, "decimal" ], [ "max_tokens", pcs.max_tokens, "—", "numeric" ]].each do |name, value, placeholder, inputmode|
            div class="w-16 shrink-0"
              label class="#{kb_label} mb-1 font-mono text-[10px] leading-tight" for="service_connection_prompt_conversion_settings_#{name}" = name
              input id="service_connection_prompt_conversion_settings_#{name}" type="text" name="service_connection[prompt_conversion_settings][#{name}]" value=value placeholder=placeholder inputmode=inputmode autocomplete="off" data-prompt-conversion-settings-field=name class="#{kb_field_input_classes} w-16 max-w-16 font-mono text-xs px-1"
          div class="w-24 shrink-0"
            label class="#{kb_label} mb-1 font-mono text-[10px] leading-tight" for="service_connection_prompt_conversion_settings_reasoning_effort" reasoning_effort
            select#service_connection_prompt_conversion_settings_reasoning_effort name="service_connection[prompt_conversion_settings][reasoning_effort]" data-prompt-conversion-settings-field="reasoning_effort" class="#{kb_field_input_classes} w-24 max-w-24 font-mono text-xs px-1"
              option value="" selected=pcs.reasoning_effort.nil? —
              - LlmSamplingParams::REASONING_EFFORTS.each do |value|
                option value=value selected=(pcs.reasoning_effort == value) = value

  div
    = form.label :notes, "メモ", class: "#{kb_label} mb-1"
    = form.text_area :notes, rows: 3, class: kb_field_input_classes

  .flex.flex-wrap.items-center.gap-4
    div
      = form.label :sort_order, "表示順", class: "#{kb_label} mb-1"
      = form.number_field :sort_order, min: 0, step: 1, class: kb_field_input_classes
    label.flex.items-center.gap-2.text-sm
      = form.check_box :enabled, class: "kb-control-accent"
      span 有効

  .flex.flex-wrap.items-center.gap-3
    - available = @available_keys || ServiceConnection.available_keys
    - submit_disabled = !service_connection.persisted? && !custom_llm && available.empty?
    = form.submit(service_connection.persisted? ? "更新" : "作成", class: kb_btn_primary_sm, disabled: submit_disabled)
    = link_to "キャンセル", service_connection.persisted? ? service_connection_path(service_connection) : service_connections_path, class: "kb-chrome-link text-sm"
