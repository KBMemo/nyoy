- content_for :title, "LLM サーバー"

.mb-6.flex.flex-wrap.items-center.justify-between.gap-3
  h1 class=kb_page_title LLM サーバー
  .flex.flex-wrap.items-center.gap-2
    = link_to "定義を作成", new_llama_server_path, class: kb_btn_primary_sm
    = link_to "接続へ戻る", service_connections_path, class: kb_btn_secondary_sm

- unless @switchd_connection
  .kb-alert.kb-alert-danger
    | llama_switchd 接続がありません。「接続」で組み込み接続を登録してください。
- else
  .kb-card.p-4.mb-4
    dl.grid.gap-2.text-sm class="sm:grid-cols-[auto_1fr]"
      dt.font-medium.kb-text-secondary 管理 API
      dd.nyoy-monospace = @switchd_connection.base_url
      dt.font-medium.kb-text-secondary 状態
      dd = @switchd_connection.enabled? ? "有効" : "無効"

  - unless @switchd_connection.enabled?
    .kb-alert.kb-alert-danger llama_switchd 接続が無効です。トークンを設定して有効化してください。
  - if @inventory_error
    .kb-alert.kb-alert-danger = @inventory_error
  - if @inventory
    section.mb-6
      h2 class=kb_section_title 管理中のサーバー
      .mt-3.overflow-x-auto
        table.w-full.text-sm
          thead
            tr.border-b
              th.p-2.text-left ID
              th.p-2.text-left Alias
              th.p-2.text-right Port
              th.p-2.text-left 状態
              th.p-2.text-left 起動設定
              th.p-2.text-left Source
              th.p-2.text-left 操作
          tbody
            - @inventory.servers.each do |server|
              tr.border-b
                td.p-2.nyoy-monospace = server["id"]
                td.p-2.nyoy-monospace = server["alias"]
                td.p-2.text-right.nyoy-monospace = server["port"]
                td.p-2
                  = server["state"]
                  - if server["ready"]
                    span.kb-badge.kb-badge-muted.ml-2 ready
                td.p-2
                  = server["enabled"] ? "enabled" : "disabled"
                  - if server["restart_required"]
                    span.kb-badge.kb-badge-muted.ml-2 再起動待ち
                td.p-2.nyoy-monospace.break-all = server["source"]
                td.p-2
                  - active_operation = @active_llama_server_operations[server["id"]]
                  - if active_operation
                    span.kb-status-warning = active_operation.status_label
                  - else
                    .flex.flex-wrap.items-center.gap-2
                      - if server["active"]
                        = button_to "停止", operate_llama_server_service_connections_path, method: :post, params: { managed_server_id: server["id"], server_action: "stop" }, class: kb_btn_secondary_sm, form: { data: { turbo_confirm: "#{server['id']} を停止しますか？" } }
                        = button_to "再起動", operate_llama_server_service_connections_path, method: :post, params: { managed_server_id: server["id"], server_action: "restart" }, class: kb_btn_secondary_sm, form: { data: { turbo_confirm: "#{server['id']} を再起動しますか？" } }
                      - else
                        = button_to "起動", operate_llama_server_service_connections_path, method: :post, params: { managed_server_id: server["id"], server_action: "start" }, class: kb_btn_secondary_sm
                      - if server["enabled"]
                        = button_to "自動起動を無効化", operate_llama_server_service_connections_path, method: :post, params: { managed_server_id: server["id"], server_action: "disable" }, class: kb_btn_secondary_sm, form: { data: { turbo_confirm: "#{server['id']} の自動起動を無効にしますか？" } }
                      - else
                        = button_to "自動起動を有効化", operate_llama_server_service_connections_path, method: :post, params: { managed_server_id: server["id"], server_action: "enable" }, class: kb_btn_secondary_sm
                    .mt-2.flex.flex-wrap.items-center.gap-2
                      = link_to "定義を編集", edit_llama_server_path(server["id"]), class: "kb-chrome-link text-sm"
                      - unless server["active"] || server["enabled"]
                        = button_to "定義を削除", llama_server_path(server["id"]), method: :delete, class: "kb-chrome-link text-sm nyoy-inline-delete-btn", form: { data: { turbo_confirm: "#{server['id']} の定義を削除しますか？" } }

    section.mb-6
      h2 class=kb_section_title Nyoy 接続との差分
      .mt-3.overflow-x-auto
        table.w-full.text-sm
          thead
            tr.border-b
              th.p-2.text-left 接続
              th.p-2.text-left 現在値
              th.p-2.text-left switchd
              th.p-2.text-left 判定
          tbody
            - @inventory.connections.each do |comparison|
              - connection = comparison.connection
              - server = comparison.server
              tr.border-b
                td.p-2
                  = link_to connection.name, connection, class: "kb-chrome-link"
                  .nyoy-monospace.text-xs.kb-text-muted = connection.key
                td.p-2
                  .nyoy-monospace = connection.base_url
                  .nyoy-monospace.text-xs.kb-text-muted = connection.server_model.presence || "alias 未設定"
                td.p-2
                  - if server
                    .nyoy-monospace = "#{server['id']} :#{server['port']}"
                    .nyoy-monospace.text-xs.kb-text-muted = server["alias"]
                  - else
                    span.kb-text-muted 候補なし
                td.p-2
                  - labels = { exact: "一致", port_only: "Alias 不一致", alias_only: "Port 不一致", unmatched: "未対応" }
                  span class=(comparison.status == :exact ? "kb-status-success" : "kb-status-warning") = labels.fetch(comparison.status)
                  = form_with url: bind_llama_server_service_connection_path(connection), method: :patch, class: "mt-2 flex items-center gap-2" do
                    = select_tag :managed_server_id, options_for_select(@inventory.servers.map { |item| ["#{item['id']} (:#{item['port']})", item["id"]] }, connection.managed_server_id || server&.dig("id")), class: kb_field_input_classes
                    = submit_tag "紐付け", class: kb_btn_secondary_sm
                  - if connection.managed_server_id.present?
                    .mt-2.flex.items-center.gap-2
                      span.text-xs.kb-text-muted = "紐付け済み: #{connection.managed_server_id}"
                      = button_to "URL・Aliasを同期", sync_llama_server_service_connection_path(connection), method: :post, class: kb_btn_secondary_sm

    section
      h2 class=kb_section_title 検出モデル
      p.mt-2.text-sm.kb-text-secondary = "#{@inventory.models.size} 件"
      - if @inventory.models.any?
        ul.mt-3.divide-y
          - @inventory.models.each do |model|
            li.py-2.text-sm
              .nyoy-monospace.break-all = model["path"]
              .text-xs.kb-text-muted
                = model["suggested_id"]
                - if model["configured_as"].present?
                  = " / 使用中: #{model['configured_as'].join(', ')}"

    section.mt-6
      h2 class=kb_section_title 操作履歴
      - if @llama_server_operations.any?
        .mt-3.overflow-x-auto
          table.w-full.text-sm
            thead
              tr.border-b
                th.p-2.text-left 受付日時
                th.p-2.text-left Server
                th.p-2.text-left 操作
                th.p-2.text-left 状態
                th.p-2.text-left 結果
            tbody
              - @llama_server_operations.each do |operation|
                tr.border-b
                  td.p-2 = l(operation.created_at, format: :short)
                  td.p-2.nyoy-monospace = operation.managed_server_id
                  td.p-2 = operation.action_label
                  td.p-2 = operation.status_label
                  td.p-2
                    - if operation.error_message.present?
                      span.kb-status-danger = operation.error_message
                    - elsif operation.finished_at
                      span.kb-text-muted = "完了 #{l(operation.finished_at, format: :short)}"
      - else
        p.mt-2.text-sm.kb-text-muted 操作履歴はありません。
