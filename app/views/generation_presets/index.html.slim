.mb-6
  .flex.flex-wrap.items-center.justify-between.gap-3
    h1 class=kb_page_title 生成プリセット
    .flex.flex-wrap.items-center.gap-2
      = link_to "案出しプリセット", new_generation_preset_path(preset_kind: "draft"), class: kb_btn_secondary_sm
      = link_to "本番プリセット", new_generation_preset_path(preset_kind: "refine"), class: kb_btn_primary_sm
  p.mt-1.text-sm.kb-text-secondary 案出し (ラフ生成) と本番 (img2img / Hires) の設定を分けて管理します。

- if @draft_presets.any?
  h2.mt-6 class=kb_section_title 案出し
  section.nyoy-card-list.mt-3
    - @draft_presets.each do |preset|
      = render "preset_card", preset: preset, show_generate_link: true

- if @refine_presets.any?
  h2.mt-8 class=kb_section_title 本番
  section.nyoy-card-list.mt-3
    - @refine_presets.each do |preset|
      = render "preset_card", preset: preset, show_generate_link: false

- if @draft_presets.empty? && @refine_presets.empty?
  p.text-sm.kb-text-muted プリセットが未登録です。
