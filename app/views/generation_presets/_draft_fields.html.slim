.grid.gap-4.sm:grid-cols-2
  div
    = form.label :draft_batch_size, "ラフ枚数", class: "#{kb_label} mb-1"
    = form.select :draft_batch_size, options_for_select([[2, 2], [3, 3], [4, 4]], generation_preset.draft_batch_size || 4), {}, class: kb_field_input_classes
  div
    = form.label :draft_steps, "ラフ Steps (任意)", class: "#{kb_label} mb-1"
    = form.number_field :draft_steps, min: 1, max: 150, step: 1, class: kb_field_input_classes, placeholder: "空欄なら steps まで自動"

p.text-sm.kb-text-muted 案出しプリセットはラフ生成 (txt2img batch) 用の設定です。
