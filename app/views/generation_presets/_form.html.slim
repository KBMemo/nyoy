- content_for :title, title

.mb-6
  h1 class=kb_page_title = title

= render "shared/sd_catalog_status"

= form_with model: generation_preset, class: "space-y-4" do |form|
  - if generation_preset.errors.any?
    .kb-alert.kb-alert-danger
      ul.list-disc.pl-5
        - generation_preset.errors.full_messages.each do |message|
          li = message

  div
    = form.label :name, "名前", class: "#{kb_label} mb-1"
    = form.text_field :name, required: true, class: kb_field_input_classes

  - if generation_preset.persisted?
    p.text-sm.kb-text-secondary 種別: #{generation_preset.preset_kind_label}
    = form.hidden_field :preset_kind
  - else
    div
      = form.label :preset_kind, "種別", class: "#{kb_label} mb-1"
      = form.select :preset_kind, GenerationPreset::PRESET_KIND_LABELS.map { |key, label| [label, key] }, {}, class: kb_field_input_classes

  - if generation_preset.refine?
    = render "refine_fields", form: form, generation_preset: generation_preset
  - else
    div
      = form.label :default_negative_prompt, "デフォルトネガティブプロンプト (任意)", class: "#{kb_label} mb-1"
      = form.text_area :default_negative_prompt, rows: 2, class: kb_field_input_classes, placeholder: "low quality, blurry, text, watermark"

    = render "shared/generation_settings_fields",
      form_object: generation_preset,
      form_builder: form,
      generation_presets: [],
      prompt_skills: @prompt_skills,
      sd_models: @sd_models,
      sd_loras: @sd_loras,
      sd_samplers: @sd_samplers,
      lora_catalog_error: @lora_catalog_error,
      show_preset_select: false,
      require_prompt_skill: false

    = render "draft_fields", form: form, generation_preset: generation_preset

  label.flex.items-center.gap-2.text-sm
    = form.check_box :default, class: "kb-control-accent"
    span = "#{generation_preset.refine? ? '本番' : '案出し'}のデフォルトプリセットにする"

  .flex.flex-wrap.items-center.gap-3
    = form.submit(generation_preset.persisted? ? "更新" : "作成", class: kb_btn_primary_sm, disabled: (!generation_preset.refine? && @sd_models.empty?))
    = link_to "キャンセル", generation_presets_path, class: "kb-chrome-link text-sm"
