.mb-6
  h1 class=kb_page_title = @prompt_lora.name

.kb-card.p-4.space-y-4
  - if @prompt_lora.path.present?
    p.text-sm
      span.kb-text-secondary path:
      span.ml-2.nyoy-monospace = @prompt_lora.path
  - if @prompt_lora.trigger_words.present?
    p.text-sm
      span.kb-text-secondary trigger:
      span.ml-2 = @prompt_lora.trigger_words
  p.text-sm
    span.kb-text-secondary models:
    span.ml-2 = @prompt_lora.compatible_models_list.any? ? @prompt_lora.compatible_models_list.join(", ") : "（未指定）"
  p.text-sm
    span.kb-text-secondary weight:
    span.ml-2 = "#{@prompt_lora.weight_min} .. #{@prompt_lora.weight_max}"
  - if @prompt_lora.notes.present?
    pre.text-sm.whitespace-pre-wrap = @prompt_lora.notes

.flex.flex-wrap.items-center.gap-3.mt-6
  = link_to "編集", edit_prompt_lora_path(@prompt_lora), class: kb_btn_primary_sm
  = link_to "一覧へ", prompt_loras_path, class: "kb-chrome-link text-sm"
