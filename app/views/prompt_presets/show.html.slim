.mb-6
  .flex.flex-wrap.items-center.gap-2
    h1 class=kb_page_title = @prompt_preset.name
    span.kb-badge.kb-badge-muted = @prompt_preset.model_family_label

.kb-card.p-4.space-y-4
  - if @prompt_preset.positive_template.present?
    div
      h2 class=kb_section_title Positive
      pre.text-sm.whitespace-pre-wrap.nyoy-monospace = @prompt_preset.positive_template
  - if @prompt_preset.negative_template.present?
    div
      h2 class=kb_section_title Negative
      pre.text-sm.whitespace-pre-wrap.nyoy-monospace = @prompt_preset.negative_template
  - if @prompt_preset.default_params.present?
    div
      h2 class=kb_section_title Default params
      pre.text-sm.whitespace-pre-wrap.nyoy-monospace = JSON.pretty_generate(@prompt_preset.default_params)

.flex.flex-wrap.items-center.gap-3.mt-6
  = link_to "編集", edit_prompt_preset_path(@prompt_preset), class: kb_btn_primary_sm
  = link_to "一覧へ", prompt_presets_path, class: "kb-chrome-link text-sm"
