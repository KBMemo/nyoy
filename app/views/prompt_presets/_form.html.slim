= form_with model: prompt_preset, class: "space-y-4 max-w-3xl" do |form|
  - if prompt_preset.errors.any?
    .kb-alert.kb-alert-danger
      ul.list-disc.pl-5
        - prompt_preset.errors.full_messages.each do |message|
          li = message

  div
    = form.label :name, "名前", class: "#{kb_label} mb-1"
    = form.text_field :name, required: true, class: kb_field_input_classes

  div
    = form.label :model_family, "モデル系", class: "#{kb_label} mb-1"
    = form.select :model_family, PromptPreset::MODEL_FAMILY_LABELS.map { |key, label| [label, key] }, {}, class: kb_field_input_classes

  div
    = form.label :positive_template, "Positive テンプレート", class: "#{kb_label} mb-1"
    = form.text_area :positive_template, rows: 4, class: "#{kb_field_input_classes} nyoy-monospace"

  div
    = form.label :negative_template, "追加ネガティブ方針 (RAG)", class: "#{kb_label} mb-1"
    = form.text_area :negative_template, rows: 3, class: "#{kb_field_input_classes} nyoy-monospace"
    p.mt-1.text-sm.kb-text-muted LLM 向けの situational な追加 tag の指針。固定ネガティブはスキル/プリセットで実行時適用されます。

  div
    = form.label :default_params, "default_params (JSON)", class: "#{kb_label} mb-1"
    = form.text_area :default_params_json, rows: 4, class: "#{kb_field_input_classes} nyoy-monospace"
    p.mt-1.text-xs.kb-text-muted 例: {"steps":28,"cfg_scale":6.5}

  .flex.flex-wrap.items-center.gap-3
    - if prompt_preset.persisted?
      = form.submit "更新", class: kb_btn_primary_sm
      = form.submit "別名で保存", name: "save_as", class: kb_btn_secondary_sm
    - else
      = form.submit "作成", class: kb_btn_primary_sm
    = link_to "キャンセル", prompt_presets_path, class: "kb-chrome-link text-sm"
