.mb-6.flex.flex-wrap.items-center.justify-between.gap-3
  h1 class=kb_page_title サンプリングプリセット
  = link_to "新規登録", new_llm_sampling_preset_path, class: kb_btn_primary_sm

p.text-sm.kb-text-secondary
  | コミュニティ推奨などの LLM サンプリング設定です。接続のプロンプト変換フォームに適用できます。
  | JSON API:
  code.nyoy-monospace.ml-1 = llm_sampling_presets_path(format: :json)

- if @llm_sampling_presets.any?
  section.nyoy-card-list.mt-4
    - @llm_sampling_presets.each do |preset|
      article.kb-card.p-4
        .flex.flex-wrap.items-center.justify-between.gap-2
          h2.text-base.font-semibold
            = link_to preset.name, preset, class: "kb-text-primary no-underline"
          .flex.flex-wrap.items-center.gap-2
            span.kb-badge.kb-badge-muted.nyoy-monospace = preset.key
            - if preset.builtin?
              span.kb-badge.kb-badge-muted 組み込み
            - unless preset.enabled?
              span.kb-badge.kb-badge-muted 無効
        - if preset.model_name_match.present?
          p.mt-2.text-sm.kb-text-secondary
            | モデル一致:
            span.nyoy-monospace.ml-1 = preset.model_name_match
        p.mt-2.text-sm.nyoy-monospace.kb-text-secondary = preset.sampling_params.to_h_compact.to_json
        - if preset.notes.present?
          p.mt-2.text-sm.kb-text-muted = truncate(preset.notes, length: 120)
        .mt-3
          = link_to "編集", edit_llm_sampling_preset_path(preset), class: "kb-chrome-link text-sm"
- else
  p.mt-4.text-sm.kb-text-muted プリセットがありません。seeds を実行するか新規登録してください。
