- content_for :title, "LLM用途"

.mb-6.flex.flex-wrap.items-center.justify-between.gap-3
  h1 class=kb_page_title LLM用途
  .flex.flex-wrap.items-center.gap-3.text-sm
    = link_to "接続", service_connections_path, class: "kb-chrome-link"
    = link_to "サンプリング", llm_sampling_presets_path, class: "kb-chrome-link"

- missing_count = LlmUsageCatalog.all.size - @assignments.size
- if missing_count.positive?
  .kb-alert.kb-alert-warning.mb-4
    = "モデルを解決できない用途が#{missing_count}件あります。接続とモデル登録を確認してください。"

section.space-y-4 aria-label="LLM用途割当"
  - @assignments.each do |assignment|
    - definition = assignment.definition
    - model_options = @model_options.fetch(assignment.id)
    - connection = assignment.model.resolved_service_connection
    article.kb-card.p-4 id=dom_id(assignment)
      = form_with model: assignment, class: "space-y-4" do |form|
        .flex.flex-wrap.items-start.justify-between.gap-3
          div
            h2.text-base.font-semibold.kb-text-primary = definition.label
            code.nyoy-monospace.text-xs.kb-text-muted = definition.key
          .flex.flex-wrap.items-center.gap-2
            - definition.capabilities.each do |capability|
              span.kb-badge.kb-badge-muted = capability
            - if @missing_capabilities.fetch(assignment.id).any?
              span.kb-badge.kb-status-danger 能力不足
            - unless connection&.enabled?
              span.kb-badge.kb-status-danger 接続利用不可

        - if assignment.errors.any?
          .kb-alert.kb-alert-danger role="alert"
            ul.list-disc.pl-5
              - assignment.errors.full_messages.each do |message|
                li = message

        .grid.gap-4.md:grid-cols-2
          div
            = form.label :model_id, "主モデル", class: kb_label
            = form.select :model_id,
                options_for_select(model_options, assignment.model_id),
                {},
                class: kb_field_input_classes,
                required: true
          div
            = form.label :fallback_model_id, "Fallbackモデル", class: kb_label
            = form.select :fallback_model_id,
                options_for_select(model_options, assignment.fallback_model_id),
                { include_blank: "なし" },
                class: kb_field_input_classes
          div
            = form.label :llm_sampling_preset_id, "Sampling preset", class: kb_label
            = form.collection_select :llm_sampling_preset_id,
                @sampling_presets,
                :id,
                :name,
                { include_blank: "指定なし" },
                class: kb_field_input_classes
          .flex.items-end
            label.flex.min-h-10.items-center.gap-2
              = form.check_box :enabled, class: "kb-control-accent"
              span.text-sm.kb-text-secondary 有効

        .flex.justify-end
          = form.submit "保存", class: kb_btn_primary_sm
