.mb-4.text-sm.kb-text-secondary
  - if @catalog_error.present?
    span.nyoy-catalog-error SD モデル一覧を取得できません: #{@catalog_error}
  - else
    - if @current_sd_model.present?
      | 現在の SD モデル:
      strong.kb-text-primary = " #{@current_sd_model}"
    - if @sd_models.present?
      - if @current_sd_model.present?
        |  ·
      |  利用可能: #{@sd_models.join(", ")}
