#flash-live class="kb-flash-stack pointer-events-none fixed top-4 right-4 z-50 flex flex-col gap-2" data-flash-notice-target="live" aria-live="polite"
  - flash.each do |level, message|
    - next if message.blank?
    - alert_classes = (level.to_sym == :notice) ? "kb-alert-success" : "kb-alert-warning"
    - dismiss_ring = (level.to_sym == :notice) ? "kb-flash-dismiss-success" : "kb-flash-dismiss-warning"
    div class="pointer-events-auto flex items-start gap-2 kb-alert shadow-md transition-all duration-200 ease-out #{alert_classes}" role="status" data-flash-notice-target="message"
      span.min-w-0.flex-1 = message
      button.shrink-0.rounded.p-0.5.text-base.leading-none.opacity-60.hover:opacity-100.kb-flash-dismiss type="button" class=dismiss_ring data-action="flash-notice#dismiss" aria-label="メッセージを閉じる"
        | ×
