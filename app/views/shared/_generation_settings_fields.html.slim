- form_object = local_assigns.fetch(:form_object)
- form_builder = local_assigns.fetch(:form_builder)
- generation_presets = local_assigns.fetch(:generation_presets, [])
- prompt_skills = local_assigns.fetch(:prompt_skills, [])
- sd_loras = local_assigns.fetch(:sd_loras, [])
- sd_samplers = local_assigns.fetch(:sd_samplers, %w[euler_a])
- show_preset_select = local_assigns.fetch(:show_preset_select, false)
- lora_catalog_error = local_assigns[:lora_catalog_error]

section.space-y-4 data-controller="preset-form" data-preset-form-presets-value=generation_presets_stimulus_data(generation_presets).to_json data-preset-form-loras-value=sd_loras_stimulus_data(sd_loras).to_json data-preset-form-initial-loras-value=form_object.loras_array.to_json
  - if local_assigns.fetch(:show_negative_prompt, false)
    div
      = form_builder.label :negative_prompt, "追加ネガティブ (任意)", class: "#{kb_label} mb-1"
      = form_builder.text_area :negative_prompt, rows: 2, class: kb_field_input_classes, placeholder: "photorealistic, detailed background", data: { preset_form_target: "negativePrompt" }
      p.mt-1.text-sm.kb-text-muted スキルとプリセットの固定ネガティブは生成時に自動適用されます。ここはシーン向けの追加 tag のみ。
  - if show_preset_select && generation_presets.any?
    div
      label.kb-label.mb-1 for="generation_preset_select" 案出しプリセット
      select#generation_preset_select class=kb_field_input_classes data-preset-form-target="presetSelect" data-action="change->preset-form#applyPreset"
        option value="" カスタム
        - generation_presets.each do |preset|
          option value=preset.id selected=(form_object.generation_preset_id == preset.id)
            = preset.name
            - if preset.default?
              |  (default)
      = form_builder.hidden_field :generation_preset_id, data: { preset_form_target: "generationPresetId" }

  - if lora_catalog_error.present?
    .kb-alert.kb-alert-warning
      p LoRA 一覧の取得に失敗しました: #{lora_catalog_error}

  div
    = form_builder.label :sd_model, "SD モデル", class: "#{kb_label} mb-1"
    = form_builder.select :sd_model, sd_models, {}, required: true, disabled: sd_models.empty?, class: kb_field_input_classes, data: { preset_form_target: "sdModel" }

  - if local_assigns.fetch(:show_prompt_skill, true) && prompt_skills.any?
    div
      = form_builder.label :prompt_skill_id, "プロンプトスキル", class: "#{kb_label} mb-1"
      = form_builder.collection_select :prompt_skill_id, prompt_skills, :id, :name, { include_blank: "デフォルト翻訳" }, class: kb_field_input_classes, data: { preset_form_target: "promptSkillId" }
  - elsif local_assigns.fetch(:require_prompt_skill, false)
    .kb-alert.kb-alert-warning
      p
        | プロンプトスキルが未登録です。
        = link_to "スキルを作成", new_prompt_skill_path, class: "kb-chrome-link"
        | してください。

  .nyoy-field-grid
    div
      = form_builder.label :width, "幅", class: "#{kb_label} mb-1"
      = form_builder.number_field :width, min: 64, max: 2048, step: 64, class: kb_field_input_classes, data: { preset_form_target: "width" }
    div
      = form_builder.label :height, "高さ", class: "#{kb_label} mb-1"
      = form_builder.number_field :height, min: 64, max: 2048, step: 64, class: kb_field_input_classes, data: { preset_form_target: "height" }
    div
      = form_builder.label :steps, "Steps", class: "#{kb_label} mb-1"
      = form_builder.number_field :steps, min: 1, max: 150, class: kb_field_input_classes, data: { preset_form_target: "steps" }
    div
      = form_builder.label :cfg_scale, "CFG Scale", class: "#{kb_label} mb-1"
      = form_builder.number_field :cfg_scale, min: 1, max: 30, step: 0.5, class: kb_field_input_classes, data: { preset_form_target: "cfgScale" }
    div
      = form_builder.label :sampler_name, "Sampler", class: "#{kb_label} mb-1"
      = form_builder.select :sampler_name, sd_samplers, {}, class: kb_field_input_classes, data: { preset_form_target: "samplerName" }
    - if local_assigns.fetch(:show_seed, false)
      div
        = form_builder.label :seed, "Seed (空欄でランダム)", class: "#{kb_label} mb-1"
        = form_builder.number_field :seed, min: -1, class: kb_field_input_classes
    div
      label.flex.items-center.gap-2.text-sm.mt-6
        = form_builder.check_box :vae_tiling, class: "kb-control-accent", data: { preset_form_target: "vaeTiling" }
        span VAE Tiling

  .kb-card.p-4
    .flex.flex-wrap.items-baseline.gap-x-3.gap-y-1
      h2 class=kb_section_title LoRA
      p.text-sm.kb-text-secondary sd-server にインストール済みの LoRA から選択します。

    = form_builder.hidden_field :loras, data: { preset_form_target: "lorasField" }
    .nyoy-lora-rows data-preset-form-target="loraRows"

    - if sd_loras.any?
      div.mt-3
        .nyoy-lora-add-row
          select#lora_catalog_select class=kb_field_input_classes data-preset-form-target="loraCatalog"
            option value="" 選択してください
            - sd_loras.each do |entry|
              option value=entry["path"] data-name=entry["name"]
                = entry["name"]
          button.kb-chrome-btn-secondary.kb-btn-sm type="button" data-action="preset-form#addLora" 追加
    - else
      p.text-sm.kb-text-muted LoRA が見つかりません。
