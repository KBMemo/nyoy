- content_for :title, "Graph設定"

.mb-6.flex.flex-wrap.items-center.justify-between.gap-3
  h1 class=kb_page_title Graph設定
  = link_to "LLM用途", llm_usage_assignments_path, class: "kb-chrome-link text-sm"

= form_with model: @app_setting, url: app_settings_path, method: :patch, class: "space-y-6" do |form|
  - if @app_setting.errors.any?
    .kb-alert.kb-alert-danger role="alert"
      ul.list-disc.pl-5
        - @app_setting.errors.full_messages.each do |message|
          li = message

  fieldset
    legend class="#{kb_label} mb-1" 調査ドラフト方式
    p#agent-graph-draft-profile-help.mt-1.text-sm.kb-text-muted
      | 現在:
      code.nyoy-monospace.ml-1 = AgentGraph::RoleServices.profile_for(:draft)
    .mt-2.space-y-2
      - @research_draft_profile_options.each do |label, value|
        label.flex.min-h-10.items-center.gap-2
          = form.radio_button :agent_graph_draft_profile,
              value,
              class: "kb-control-accent",
              aria: { describedby: "agent-graph-draft-profile-help" }
          span.text-sm.kb-text-secondary = label

  div
    = form.label :research_draft_fallback, "調査ドラフト失敗時", class: "#{kb_label} mb-1"
    = form.select :research_draft_fallback,
        options_for_select(@research_draft_fallback_options, @app_setting.research_draft_fallback.presence || "main"),
        {},
        class: kb_field_input_classes

  fieldset
    legend class="#{kb_label} mb-1" 最終回答方式
    p#agent-graph-final-answer-profile-help.mt-1.text-sm.kb-text-muted
      | 現在:
      code.nyoy-monospace.ml-1 = AgentGraph::RoleServices.profile_for(:final_answer)
    .mt-2.space-y-2
      - @final_answer_profile_options.each do |label, value|
        label.flex.min-h-10.items-center.gap-2
          = form.radio_button :agent_graph_final_answer_profile,
              value,
              class: "kb-control-accent",
              aria: { describedby: "agent-graph-final-answer-profile-help" }
          span.text-sm.kb-text-secondary = label

  fieldset
    legend class="#{kb_label} mb-1" 調査計画方式
    p#agent-graph-planner-profile-help.mt-1.text-sm.kb-text-muted
      | 現在:
      code.nyoy-monospace.ml-1 = AgentGraph::RoleServices.profile_for(:planner)
    .mt-2.space-y-2
      - @research_planner_profile_options.each do |label, value|
        label.flex.min-h-10.items-center.gap-2
          = form.radio_button :agent_graph_planner_profile,
              value,
              class: "kb-control-accent",
              aria: { describedby: "agent-graph-planner-profile-help" }
          span.text-sm.kb-text-secondary = label

  fieldset
    legend class="#{kb_label} mb-1" 根拠十分性判定方式
    p#agent-graph-evidence-evaluator-profile-help.mt-1.text-sm.kb-text-muted
      | 現在:
      code.nyoy-monospace.ml-1 = AgentGraph::RoleServices.profile_for(:evidence_evaluator)
    .mt-2.space-y-2
      - @evidence_evaluator_profile_options.each do |label, value|
        label.flex.min-h-10.items-center.gap-2
          = form.radio_button :agent_graph_evidence_evaluator_profile,
              value,
              class: "kb-control-accent",
              aria: { describedby: "agent-graph-evidence-evaluator-profile-help" }
          span.text-sm.kb-text-secondary = label

  fieldset
    legend class="#{kb_label} mb-1" Graph起動判定方式
    p#agent-graph-intent-profile-help.mt-1.text-sm.kb-text-muted
      | 現在:
      code.nyoy-monospace.ml-1 = AgentGraph::RoleServices.profile_for(:intent)
    .mt-2.space-y-2
      - @agent_graph_intent_profile_options.each do |label, value|
        label.flex.min-h-10.items-center.gap-2
          = form.radio_button :agent_graph_intent_profile,
              value,
              class: "kb-control-accent",
              aria: { describedby: "agent-graph-intent-profile-help" }
          span.text-sm.kb-text-secondary = label

  div
    = form.submit "保存", class: kb_btn_primary_sm
