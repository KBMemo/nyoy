<h1>如意 (Nyoy)</h1>
<p class="lead">ローカル生成AI — 画像生成</p>

<% if @current_sd_model.present? %>
  <p class="meta">現在の SD モデル: <strong><%= @current_sd_model %></strong></p>
<% end %>

<p><%= link_to "新しい画像を生成", new_image_generation_path, class: "button" %></p>

<% if @image_generations.any? %>
  <section class="card-list">
    <% @image_generations.each do |generation| %>
      <%= link_to image_generation_path(generation), class: "card" do %>
        <div class="card-header">
          <span class="status status-<%= generation.status %>"><%= generation.status %></span>
          <span class="model"><%= generation.sd_model %></span>
        </div>
        <p class="prompt"><%= truncate(generation.japanese_prompt, length: 80) %></p>
        <% if generation.image.attached? %>
          <%= image_tag generation.image.variant(resize_to_limit: [256, 256]), alt: generation.japanese_prompt %>
        <% end %>
      <% end %>
    <% end %>
  </section>
<% else %>
  <p class="empty">まだ生成履歴がありません。</p>
<% end %>
