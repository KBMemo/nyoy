- if @image_generation.in_progress?
  - content_for :head do
    meta http-equiv="refresh" content="3"

h1 生成結果

p.meta
  span class="status status-#{@image_generation.status}" = @image_generation.status
  |  · #{@image_generation.sd_model}

section.card.detail
  h2 日本語プロンプト
  p = simple_format(@image_generation.japanese_prompt)

  - if @image_generation.prompt.present?
    h2 SD プロンプト (英語)
    p = simple_format(@image_generation.prompt)

  - if @image_generation.negative_prompt.present?
    h2 ネガティブプロンプト
    p = simple_format(@image_generation.negative_prompt)

  - if @image_generation.error_message.present?
    .errors
      p = @image_generation.error_message

  - if @image_generation.in_progress?
    p.loading 生成中です… このページは自動更新されます。

  - if @image_generation.image.attached?
    figure.result-image
      = image_tag @image_generation.image, alt: @image_generation.japanese_prompt

p
  = link_to "新しい画像を生成", new_image_generation_path, class: "button"
  = link_to "一覧へ", root_path
