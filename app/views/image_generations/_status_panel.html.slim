= turbo_frame_tag dom_id(image_generation, :status), data: { controller: "image-preview" } do
  - refine_presets = local_assigns.fetch(:refine_presets) { @refine_render_presets || RenderPreset.of_kind("refine").ordered }
  div.mb-6.flex.flex-wrap.items-start.justify-between.gap-3
    div
      h1 class=kb_page_title 生成結果
      p.mt-1.text-sm.kb-text-secondary
        span class="nyoy-status nyoy-status-#{image_generation.status}" = image_generation.status_label
        - if image_generation.sd_model.present?
          |  · #{image_generation.sd_model}
        - if image_generation.style_label.present?
          |  · スタイル: #{image_generation.style_label}
        - if image_generation.aspect_ratio.present?
          |  · サイズ: #{image_generation.aspect_ratio_label}
        - if image_generation.render_preset
          |  · 案出し: #{image_generation.render_preset.name}
        - if image_generation.refine_render_preset
          |  · 本番: #{image_generation.refine_render_preset.name}
        = render "shared/generation_phase_timing", record: image_generation, show_prompt_timing: false

  .kb-card.p-4
    - if image_generation.japanese_prompt.present?
      h2 class=kb_section_title 日本語プロンプト
      p.mt-2.text-sm.kb-text-secondary = simple_format(image_generation.japanese_prompt)

    - if image_generation.prompt.present?
      h2 class=(image_generation.japanese_prompt.present? ? "mt-6 kb-section-title" : "kb-section-title") SD プロンプト
      p.mt-2.text-sm.nyoy-monospace = image_generation.prompt

    - if image_generation.resolved_negative_prompt.present?
      h2 class=(image_generation.prompt.present? ? "mt-6 kb-section-title" : "kb-section-title") ネガティブプロンプト
      p.mt-2.text-sm.nyoy-monospace = image_generation.resolved_negative_prompt

    h2.mt-6 class=kb_section_title 生成設定
    dl.mt-2.nyoy-settings-list
      dt サイズ
      dd = "#{image_generation.width}×#{image_generation.height}"
      dt ラフサイズ
      dd = "#{image_generation.draft_width}×#{image_generation.draft_height}（仕上げ img2img もこの解像度）"
      dt ラフ枚数 / Steps
      dd = "#{image_generation.draft_batch_size} 枚 / #{image_generation.draft_steps_for_api}"
      dt 仕上げ Steps / 強度
      dd = "#{image_generation.refine_steps_for_api} / #{image_generation.refine_denoising_strength}"
      dt Hires
      dd
        - if image_generation.enable_hires?
          | ON · #{image_generation.hires_upscaler} · #{image_generation.hires_scale}x → #{image_generation.hires_target_width}×#{image_generation.hires_target_height}
        - else
          | OFF
      dt CFG
      dd = image_generation.cfg_scale
      dt Seed
      dd = nyoy_format_seed(image_generation.seed)
      dt Sampler
      dd = image_generation.sampler_name
      dt VAE Tiling
      dd = image_generation.vae_tiling ? "ON" : "OFF"
      - if image_generation.rag_source_chunks.any?
        dt 参照ナレッジ
        dd
          ul.list-disc.pl-5
            - image_generation.rag_source_chunks.each do |chunk|
              li = link_to chunk.title, chunk, class: "kb-chrome-link"
      - image_generation.loras_for_api.each do |entry|
        dt LoRA
        dd = "#{entry['path']} (#{entry['multiplier']})"

    - if image_generation.error_message.present?
      .kb-alert.kb-alert-danger.mt-4
        p = image_generation.error_message

    - if image_generation.in_progress?
      p.mt-4.text-sm.kb-text-muted
        - if image_generation.status == "drafting"
          | ラフ案を生成中です… 状態は自動更新されます。
        - elsif image_generation.status == "refining"
          | 選択した案を img2img で仕上げ、続けて Hires で拡大しています… 状態は自動更新されます。
        - else
          | 生成中です… 状態は自動更新されます。

    - if image_generation.drafts.attached?
      - if image_generation.refineable?
        h2.mt-6 class=kb_section_title ラフ案
        p.mt-2.text-sm.kb-text-secondary
          - if image_generation.awaiting_selection?
            | サムネイルをクリックすると実寸表示します。仕上げ設定を確認して、案ごとの「仕上げ生成」を押してください。
          - else
            | サムネイルをクリックすると実寸表示します。別の案で仕上げ直す場合は設定を変えて「仕上げ生成」を押してください。

        = form_with url: refine_image_generation_path(image_generation), method: :post, class: "mt-4 space-y-4" do |form|
          = render "image_generations/refine_settings_fields", image_generation: image_generation, refine_presets: refine_presets

          .nyoy-draft-grid.mt-2
            - image_generation.drafts.each_with_index do |draft, index|
              = render "image_generations/draft_card", image_generation: image_generation, draft: draft, index: index, refineable: true, selected: index == image_generation.selected_draft_index

      - else
        h2.mt-6 class=kb_section_title ラフ案
        p.mt-2.text-sm.kb-text-secondary
          - if image_generation.status == "refining"
            | 選択した案を仕上げています。経過時間は案の下に表示されます。
          - else
            | クリックで実寸表示できます（ダイアログ内から保存も可能）。
        .nyoy-draft-grid class=(image_generation.status == "refining" ? "mt-2" : "nyoy-draft-grid-readonly mt-2")
          - image_generation.drafts.each_with_index do |draft, index|
            = render "image_generations/draft_card", image_generation: image_generation, draft: draft, index: index, refineable: false, refining: image_generation.status == "refining" && index == image_generation.selected_draft_index, selected: index == image_generation.selected_draft_index

    - if image_generation.refined_images.attached?
      h2.mt-6 class=kb_section_title 仕上がり
      p.mt-2.text-sm.kb-text-secondary 新しい順に表示します。クリックで実寸表示、保存もできます。
      .nyoy-refined-grid.mt-2
        - image_generation.refined_image_attachments.each do |attachment|
          = render "image_generations/refined_image_card", image_generation: image_generation, attachment: attachment
    - elsif image_generation.image.attached?
      h2.mt-6 class=kb_section_title 仕上がり
      figure.nyoy-result-image.mt-2
        button.nyoy-result-preview-btn type="button" data-action="click->image-preview#open:stop" data-image-preview-url=nyoy_blob_image_path(image_generation.image) data-image-preview-label="仕上がり" data-image-preview-download-url=nyoy_blob_download_path(image_generation.image, filename: "generation-#{image_generation.id}.png")
          = nyoy_blob_image_tag image_generation.image, alt: image_generation.display_summary
      .mt-2
        = link_to "画像を保存", nyoy_blob_download_path(image_generation.image, filename: "generation-#{image_generation.id}.png"), class: "kb-chrome-link text-sm", download: ""

  .flex.flex-wrap.items-center.gap-3.mt-6
    = link_to "同じ設定で再生成", new_image_generation_path(copy_from: image_generation.id), class: kb_btn_primary_sm, data: { turbo_frame: "_top" }
    = link_to "新しい画像", new_image_generation_path, class: kb_btn_secondary_sm, data: { turbo_frame: "_top" }
    = link_to "一覧へ", image_generations_path, class: "kb-chrome-link text-sm", data: { turbo_frame: "_top" }

  = render "shared/image_preview_dialog"
