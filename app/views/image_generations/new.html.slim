- content_for :title, "画像を生成"

.mb-6
  h1 class=kb_page_title 画像を生成
  p.mt-1.text-sm.kb-text-secondary 日本語プロンプトとスタイルから、モデル・LoRA・生成パラメータを自動決定します。ラフ案を選んで img2img で仕上げます。

= form_with model: @image_generation, class: "space-y-4", data: { controller: "image-generation-form", image_generation_form_translate_url_value: translate_prompt_image_generations_path } do |form|
  - if @image_generation.errors.any?
    .kb-alert.kb-alert-danger
      ul.list-disc.pl-5
        - @image_generation.errors.full_messages.each do |message|
          li = message

  div
    = form.label :japanese_prompt, "日本語プロンプト", class: "#{kb_label} mb-1"
    = form.text_area :japanese_prompt, rows: 4, required: true, class: kb_field_input_classes, placeholder: "例: 鳥獣戯画風のウサギとカエルが相撲をとっている", data: { image_generation_form_target: "japanesePrompt" }

  - if @prompt_styles.any?
    div
      = form.label :style_id, "スタイル", class: "#{kb_label} mb-1"
      = form.select :style_id, @prompt_styles.map { |s| [s.name, s.style_id] }, { include_blank: "おまかせ（自動選択）" }, class: kb_field_input_classes, data: { image_generation_form_target: "styleId" }
      p.mt-1.text-sm.kb-text-muted スタイルがモデル・LoRA・固定ネガティブ・解像度を決めます。
  - else
    .kb-alert.kb-alert-warning
      p スタイルが未登録です。seed でスタイルを作成してください。

  div
    = form.label :prompt, "SD プロンプト (任意・上書き)", class: "#{kb_label} mb-1"
    .flex.flex-wrap.items-center.gap-2.mb-1
      button.kb-chrome-btn-secondary.kb-btn-sm type="button" data-image-generation-form-target="insertSdPromptButton" data-action="image-generation-form#generateSdPrompt" data-image-generation-form-mode-param="insert" 翻訳挿入
      button.kb-chrome-btn-secondary.kb-btn-sm type="button" data-image-generation-form-target="replaceSdPromptButton" data-action="image-generation-form#generateSdPrompt" data-image-generation-form-mode-param="replace" 翻訳置換
    = form.text_area :prompt, rows: 3, class: "#{kb_field_input_classes} nyoy-monospace", placeholder: "空欄なら生成時に LLM が決定します", data: { image_generation_form_target: "sdPrompt", action: "input->image-generation-form#sdPromptInput" }
    p.mt-1.text-sm.kb-text-muted data-image-generation-form-target="translateStatus"

  div
    = form.label :negative_prompt, "追加ネガティブ (任意)", class: "#{kb_label} mb-1"
    = form.text_area :negative_prompt, rows: 2, class: kb_field_input_classes, placeholder: "busy background, hard shadows"
    p.mt-1.text-sm.kb-text-muted スタイルの固定ネガティブは自動適用されます。

  div
    = form.label :seed, "Seed (空欄でランダム)", class: "#{kb_label} mb-1"
    = form.number_field :seed, min: -1, class: kb_field_input_classes

  .kb-card.p-4
    .flex.flex-wrap.items-baseline.gap-x-3.gap-y-1
      h2 class=kb_section_title ラフ生成
      p.text-sm.kb-text-muted まず複数のラフ案を生成し、気に入った案を img2img で仕上げます。
    .nyoy-field-grid.mt-4
      - if @draft_render_presets.any?
        div
          = form.label :render_preset_id, "案出しプリセット", class: "#{kb_label} mb-1"
          = form.collection_select :render_preset_id, @draft_render_presets, :id, :name, {}, class: kb_field_input_classes
      div
        = form.label :draft_batch_size, "ラフ枚数", class: "#{kb_label} mb-1"
        = form.select :draft_batch_size, options_for_select([[2, 2], [3, 3], [4, 4]], @image_generation.draft_batch_size || 4), {}, class: kb_field_input_classes
      div
        = form.label :draft_steps, "ラフ Steps (任意)", class: "#{kb_label} mb-1"
        = form.number_field :draft_steps, min: 1, max: 150, step: 1, class: kb_field_input_classes, placeholder: "空欄なら #{[@image_generation.steps || 22, 18].min} まで"

  .kb-card.p-4
    h2 class=kb_section_title 本番仕上げ
    p.mt-2.text-sm.kb-text-muted 仕上げ生成時に使う img2img / Hires 設定です。
    .mt-4
      = render "refine_settings_fields", image_generation: @image_generation, refine_presets: @refine_render_presets, form_builder: form, preset_id_field: :refine_render_preset_id

  .flex.flex-wrap.items-center.gap-3
    = form.submit "ラフを生成", class: kb_btn_primary_sm, disabled: @prompt_styles.empty?
    = link_to "戻る", image_generations_path, class: "kb-chrome-link text-sm"
