.mb-6.flex.flex-wrap.items-end.justify-between.gap-3
  div
    h1 class=kb_page_title 画像生成 (旧)
    p.mt-1.text-sm.kb-text-secondary 日本語プロンプトから llama で英訳し、sd-server で画像を生成します。
  = link_to "新しい画像", new_image_generation_path, class: kb_btn_primary_sm

= render "shared/sd_catalog_status"

.flex.flex-wrap.items-center.gap-3.mb-6
  = link_to "生成プリセット", generation_presets_path, class: "kb-chrome-link text-sm"

- if @image_generations.any?
  section.nyoy-card-list
    - @image_generations.each do |generation|
      = link_to image_generation_path(generation), class: "nyoy-card-link" do
        .kb-card.p-4
          .flex.flex-wrap.items-center.justify-between.gap-2.mb-2
            span class="nyoy-status nyoy-status-#{generation.status}" = generation.status
            span.text-xs.kb-text-muted = generation.sd_model
          p.text-sm.kb-text-secondary = truncate(generation.japanese_prompt, length: 80)
          - if generation.image.attached?
            = image_tag generation.image.variant(resize_to_limit: [256, 256]), alt: generation.japanese_prompt
- else
  p.text-sm.kb-text-muted まだ生成履歴がありません。
