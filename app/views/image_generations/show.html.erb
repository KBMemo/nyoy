<% if @image_generation.in_progress? %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="3">
  <% end %>
<% end %>

<h1>生成結果</h1>

<p class="meta">
  <span class="status status-<%= @image_generation.status %>"><%= @image_generation.status %></span>
  · <%= @image_generation.sd_model %>
</p>

<section class="card detail">
  <h2>日本語プロンプト</h2>
  <p><%= simple_format(@image_generation.japanese_prompt) %></p>

  <% if @image_generation.prompt.present? %>
    <h2>SD プロンプト (英語)</h2>
    <p><%= simple_format(@image_generation.prompt) %></p>
  <% end %>

  <% if @image_generation.negative_prompt.present? %>
    <h2>ネガティブプロンプト</h2>
    <p><%= simple_format(@image_generation.negative_prompt) %></p>
  <% end %>

  <% if @image_generation.error_message.present? %>
    <div class="errors">
      <p><%= @image_generation.error_message %></p>
    </div>
  <% end %>

  <% if @image_generation.in_progress? %>
    <p class="loading">生成中です… このページは自動更新されます。</p>
  <% end %>

  <% if @image_generation.image.attached? %>
    <figure class="result-image">
      <%= image_tag @image_generation.image, alt: @image_generation.japanese_prompt %>
    </figure>
  <% end %>
</section>

<p><%= link_to "新しい画像を生成", new_image_generation_path, class: "button" %> <%= link_to "一覧へ", root_path %></p>
