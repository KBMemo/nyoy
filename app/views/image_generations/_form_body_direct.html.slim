- form = local_assigns.fetch(:form)

- if @sd_model_profiles.any?
  div
    = label_tag :sd_model_profile_id, "画像生成モデル", class: "#{kb_label} mb-1"
    = select_tag :sd_model_profile_id, options_from_collection_for_select(@sd_model_profiles, :id, :name, @image_generation.sd_model_profile_id), { include_blank: "選択してください", required: true, class: kb_field_input_classes, data: { image_generation_form_target: "sdModelProfileId" } }
    p.mt-1.text-sm.kb-text-muted SdModelProfile を直接指定します。スタイルは使いません。
- else
  .kb-alert.kb-alert-warning
    p 有効なモデルプロファイルがありません。設定でモデルを登録してください。

div
  = label_tag :sd_prompt_template_id, "生成テンプレート（任意）", class: "#{kb_label} mb-1"
  - template_options = @sd_prompt_templates.map { |template| ["#{template.name}（#{template.scope_label}）", template.id] }
  = select_tag :sd_prompt_template_id, options_for_select(template_options, @image_generation.sd_prompt_template_id), { include_blank: "既定を自動選択", class: kb_field_input_classes, data: { image_generation_form_target: "sdPromptTemplateId" } }
  p.mt-1.text-sm.kb-text-muted 未指定時はモデル専用 → ファミリ → グローバル既定の順で解決します。

div data-controller="prompt-token-count" data-prompt-token-count-count-url-value=sd_prompt_token_count_path
  .nyoy-prompt-heading.mb-1
    = form.label :prompt, "SD プロンプト (任意・上書き)", class: kb_label
    span.text-sm.kb-text-muted.nyoy-prompt-token-count data-prompt-token-count-target="badge" = nyoy_sd_prompt_token_badge(@image_generation.prompt)
  .flex.flex-wrap.items-center.gap-2.mb-1
    button.kb-chrome-btn-secondary.kb-btn-sm type="button" data-image-generation-form-target="directInsertSdPromptButton" data-action="image-generation-form#generateSdPrompt" data-image-generation-form-mode-param="insert" data-image-generation-form-flow-param="direct" 生成挿入
    button.kb-chrome-btn-secondary.kb-btn-sm type="button" data-image-generation-form-target="directReplaceSdPromptButton" data-action="image-generation-form#generateSdPrompt" data-image-generation-form-mode-param="replace" data-image-generation-form-flow-param="direct" 生成置換
  = form.text_area :prompt, rows: 3, class: "#{kb_field_input_classes} nyoy-monospace", placeholder: "空欄なら生成時に LLM が決定します", data: { prompt_token_count_target: "field", image_generation_form_target: "directSdPrompt", action: "input->prompt-token-count#update input->image-generation-form#directSdPromptInput" }
  p.mt-1.text-sm.kb-text-muted data-image-generation-form-target="directTranslateStatus"

div data-controller="prompt-token-count" data-prompt-token-count-count-url-value=sd_prompt_token_count_path
  .nyoy-prompt-heading.mb-1
    = form.label :negative_prompt, "ネガティブプロンプト (任意・上書き)", class: kb_label
    span.text-sm.kb-text-muted.nyoy-prompt-token-count data-prompt-token-count-target="badge" = nyoy_sd_prompt_token_badge(@image_generation.negative_prompt)
  .flex.flex-wrap.items-center.gap-2.mb-1
    button.kb-chrome-btn-secondary.kb-btn-sm type="button" data-image-generation-form-target="directInsertNegativePromptButton" data-action="image-generation-form#generateNegativePrompt" data-image-generation-form-mode-param="insert" data-image-generation-form-flow-param="direct" 生成挿入
    button.kb-chrome-btn-secondary.kb-btn-sm type="button" data-image-generation-form-target="directReplaceNegativePromptButton" data-action="image-generation-form#generateNegativePrompt" data-image-generation-form-mode-param="replace" data-image-generation-form-flow-param="direct" 生成置換
  = form.text_area :negative_prompt, rows: 2, class: "#{kb_field_input_classes} nyoy-monospace", placeholder: "空欄なら生成時に LLM が決定します", data: { prompt_token_count_target: "field", image_generation_form_target: "directNegativePrompt", action: "input->prompt-token-count#update input->image-generation-form#directNegativePromptInput" }
  p.mt-1.text-sm.kb-text-muted data-image-generation-form-target="directNegativeTranslateStatus"

div
  = form.label :seed, "Seed (空欄でランダム)", class: "#{kb_label} mb-1"
  = form.number_field :seed, min: -1, class: kb_field_input_classes

.kb-card.p-4
  h2 class=kb_section_title 実行パラメータ
  p.mt-2.text-sm.kb-text-muted txt2img の解像度・サンプリング設定です。
  .nyoy-field-grid.mt-4
    div
      = form.label :width, "Width", class: "#{kb_label} mb-1"
      = form.number_field :width, min: 64, max: 2048, step: 8, class: kb_field_input_classes
    div
      = form.label :height, "Height", class: "#{kb_label} mb-1"
      = form.number_field :height, min: 64, max: 2048, step: 8, class: kb_field_input_classes
    div
      = form.label :steps, "Steps", class: "#{kb_label} mb-1"
      = form.number_field :steps, min: 1, max: 150, step: 1, class: kb_field_input_classes
    div
      = form.label :cfg_scale, "CFG Scale", class: "#{kb_label} mb-1"
      = form.number_field :cfg_scale, min: 1, max: 30, step: 0.5, class: kb_field_input_classes
    div
      = form.label :sampler_name, "Sampler", class: "#{kb_label} mb-1"
      = form.text_field :sampler_name, class: kb_field_input_classes
    div.flex.items-end
      label.flex.items-center.gap-2.text-sm.pb-2
        = form.check_box :vae_tiling, class: "kb-control-accent"
        span VAE Tiling
