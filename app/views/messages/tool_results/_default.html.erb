<% error_message = tool.tool_error_message %>
<% if error_message.present? %>
  <%= render "messages/error",
    message: tool,
    title: "Tool Result Error",
    error_message: error_message %>
<% else %>
  <% body = tool.content.presence || "(no output)" %>
  <% preview = tool_message_preview(body) %>
  <div id="message_<%= tool.id %>" class="nyoy-chat-message nyoy-chat-message-tool">
    <details>
      <summary class="nyoy-chat-message-tool-summary">
        <span class="nyoy-chat-message-tool-summary-label">
          <span class="nyoy-chat-message-role">Tool</span>
          <span class="nyoy-chat-message-meta"><%= l(tool.created_at, format: :short) if tool.created_at %></span>
        </span>
        <% if preview.present? %>
          <span class="nyoy-chat-message-tool-preview"><%= preview %></span>
        <% end %>
      </summary>
      <pre class="nyoy-chat-message-tool-body"><%= body %></pre>
    </details>
  </div>
<% end %>
