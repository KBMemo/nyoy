<% body = tool_call_body(tool_call) %>
<% preview = tool_message_preview(body) %>
<div id="message_<%= tool_calls.id %>" class="nyoy-chat-message nyoy-chat-message-tool">
  <details>
    <summary class="nyoy-chat-message-tool-summary">
      <span class="nyoy-chat-message-tool-summary-label">
        <span class="nyoy-chat-message-role">Tool Call</span>
        <span class="nyoy-chat-message-meta"><%= l(tool_calls.created_at, format: :short) if tool_calls.created_at %></span>
      </span>
      <% if preview.present? %>
        <span class="nyoy-chat-message-tool-preview"><%= preview %></span>
      <% end %>
    </summary>
    <pre class="nyoy-chat-message-tool-body"><%= body %></pre>
  </details>
</div>
