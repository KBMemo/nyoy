<% assistant ||= local_assigns[:message] %>
<% body_text = local_assigns.fetch(:content) { assistant.content } %>
<% thinking_text = local_assigns.fetch(:thinking_text) { assistant.thinking_text } %>
<div id="message_<%= assistant.id %>" class="nyoy-chat-message nyoy-chat-message-assistant">
  <div class="nyoy-chat-message-header">
    <div class="nyoy-chat-message-role">アシスタント</div>
    <% stats = chat_message_stats(assistant) %>
    <% if stats.any? %>
      <dl class="nyoy-chat-message-stats">
        <% stats.each do |stat| %>
          <div class="nyoy-chat-message-stat">
            <dt><%= stat[:label] %></dt>
            <dd><%= stat[:value] %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </div>
  <div id="message_<%= assistant.id %>_thinking_section" class="nyoy-chat-message-thinking-section<%= " hidden" if thinking_text.blank? %>">
    <% if thinking_text.present? %>
      <details class="nyoy-chat-message-thinking-details" open>
        <summary class="nyoy-chat-message-thinking-summary">思考</summary>
        <pre id="message_<%= assistant.id %>_thinking" class="nyoy-chat-message-thinking" data-controller="thinking-auto-scroll"><%= thinking_text %></pre>
      </details>
    <% end %>
  </div>
  <div id="message_<%= assistant.id %>_content" class="nyoy-chat-message-content nyoy-chat-markdown"><%= render_chat_markdown(body_text) %></div>
  <% if assistant.cancelled? %>
    <p class="nyoy-chat-message-cancelled-note">応答を中止しました（以下は途中までの回答です）</p>
  <% end %>
  <div class="nyoy-chat-message-meta"><%= l(assistant.created_at, format: :short) if assistant.created_at %></div>
</div>
