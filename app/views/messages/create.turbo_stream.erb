<% if defined?(@chat) && @chat.present? %>
  <%= turbo_stream.before "agent_run_progress" do %>
    <%= render @message %>
  <% end %>
  <%= turbo_stream.replace "new_message" do %>
    <%= render "messages/form",
      chat: @chat,
      message: @chat.messages.build,
      form_url: chat_messages_path(@chat),
      autofocus: true %>
  <% end %>
  <%= turbo_stream.update "agent_run_progress" do %>
    <%= render "chats/response_progress",
      label: "回答を生成しています…",
      model_name: @chat.model_association&.name.presence || @chat.model_association&.model_id,
      started_at: Time.current.iso8601(3) %>
  <% end %>
  <%= turbo_stream.update "agent_run_history" do %>
    <%= render "chats/agent_run_history",
      chat: @chat,
      recent_agent_runs: @recent_agent_runs,
      show_agent_run_history: @show_agent_run_history %>
  <% end %>
<% end %>
