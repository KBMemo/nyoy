<% if defined?(@chat) && @chat.present? %>
  <%= turbo_stream.before "research_progress" do %>
    <%= render @message %>
  <% end %>
  <%= turbo_stream.replace "new_message" do %>
    <%= render "messages/form",
      chat: @chat,
      message: @chat.messages.build,
      form_url: chat_messages_path(@chat),
      autofocus: true %>
  <% end %>
<% end %>
