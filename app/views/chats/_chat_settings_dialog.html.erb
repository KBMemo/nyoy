<% connection = local_assigns.fetch(:searxng_connection, @searxng_connection) %>
<% web_settings = local_assigns.fetch(:web_tool_settings, @web_tool_settings) %>
<% llm_settings = local_assigns.fetch(:chat_llm_settings, @chat_llm_settings) %>
<dialog id="chat_settings_dialog" class="nyoy-dialog" data-dialog-target="panel" data-action="click->dialog#backdropClose">
  <div class="nyoy-dialog-panel" role="document">
    <header class="nyoy-dialog-header">
      <div>
        <h2 class="nyoy-dialog-title">チャット設定</h2>
        <p class="nyoy-dialog-description">
          このチャットのモデル応答パラメータと Web ツール上限を設定します。空欄の項目はサーバー既定値を使います。
        </p>
      </div>
      <button type="button" class="kb-chrome-btn-secondary kb-btn-sm" data-action="dialog#close" aria-label="閉じる">閉じる</button>
    </header>

    <div class="nyoy-dialog-body">
      <%= form_with url: chat_settings_chat_path(chat), method: :patch, class: "space-y-6" do |form| %>
        <section class="nyoy-dialog-section">
          <h3 class="nyoy-dialog-section-title">モデルパラメータ</h3>
          <p class="nyoy-dialog-section-description">このチャット専用のサンプリング設定です。空欄はサーバー既定です。</p>

          <div class="mt-3 flex flex-wrap items-end gap-x-3 gap-y-2">
            <% LlmSamplingParams::KEYS.each do |key| %>
              <% inputmode = LlmSamplingParams::FLOAT_KEYS.include?(key) ? "decimal" : "numeric" %>
              <div class="w-16 shrink-0">
                <%= form.label key, key, class: "#{kb_label} mb-1 font-mono text-[10px] leading-tight" %>
                <%= form.text_field key,
                  value: llm_settings.public_send(key),
                  inputmode: inputmode,
                  autocomplete: "off",
                  class: "#{kb_field_input_classes} w-16 max-w-16 font-mono text-xs px-1",
                  placeholder: "—" %>
              </div>
            <% end %>
          </div>
        </section>

        <% if connection&.enabled? %>
          <section class="nyoy-dialog-section">
            <h3 class="nyoy-dialog-section-title">Web ツール上限</h3>
            <p class="nyoy-dialog-section-description">
              応答 1 回あたりの <code>web_search</code> / <code>fetch_url</code> 呼び出し上限です（SearXNG 接続設定に保存されます）。
            </p>

            <div class="mt-4 grid gap-4 sm:grid-cols-2">
              <div>
                <%= form.label :max_searches_per_turn, "web_search 上限", class: "#{kb_label} mb-1" %>
                <%= form.number_field :max_searches_per_turn,
                  value: web_settings.max_searches_per_turn,
                  min: SearxngSettings::RANGES["max_searches_per_turn"].begin,
                  max: SearxngSettings::RANGES["max_searches_per_turn"].end,
                  step: 1,
                  class: kb_field_input_classes %>
              </div>
              <div>
                <%= form.label :max_fetches_per_turn, "fetch_url 上限", class: "#{kb_label} mb-1" %>
                <%= form.number_field :max_fetches_per_turn,
                  value: web_settings.max_fetches_per_turn,
                  min: SearxngSettings::RANGES["max_fetches_per_turn"].begin,
                  max: SearxngSettings::RANGES["max_fetches_per_turn"].end,
                  step: 1,
                  class: kb_field_input_classes %>
                <p class="mt-1 text-sm kb-text-muted">fetch_url は同時に複数実行されず、結果を受け取ってから1件ずつ取得します。</p>
              </div>
            </div>
          </section>
        <% end %>

        <div class="flex flex-wrap items-center gap-3">
          <%= form.submit "設定を更新", class: kb_btn_secondary_sm %>
          <button type="button" class="<%= kb_btn_secondary_sm %>" data-action="dialog#close">キャンセル</button>
        </div>
      <% end %>
    </div>
  </div>
</dialog>
