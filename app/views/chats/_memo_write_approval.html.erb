<% draft = agent_run.state["draft"].to_s %>
<% memo_draft = agent_run.state["memo_draft"].is_a?(Hash) ? agent_run.state["memo_draft"] : {} %>
<% approval_copy = AgentGraph::Registry.approval_copy_for(agent_run.graph_name) %>
<div class="nyoy-agent-run-approval kb-card p-4 mt-4" id="agent_run_approval_panel" data-agent-run-id="<%= agent_run.id %>">
  <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
    <div>
      <h2 class="text-base font-semibold kb-text-primary">徒然メモの確認</h2>
      <p class="mt-1 text-sm kb-text-secondary"><%= approval_copy.description %></p>
      <% if memo_draft["title"].present? %>
        <p class="mt-1 text-sm kb-text-muted">タイトル: <%= memo_draft["title"] %></p>
      <% end %>
    </div>
    <span class="text-xs kb-text-muted"><%= approval_copy.status_label %> Graph #<%= agent_run.id %></span>
  </div>

  <div class="nyoy-agent-run-approval-draft nyoy-chat-markdown mb-4">
    <%= render_chat_markdown(draft) %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= button_to approval_copy.approve_label,
      approve_chat_agent_run_path(chat, agent_run),
      method: :post,
      class: kb_btn_primary_sm %>
    <%= button_to "却下",
      reject_chat_agent_run_path(chat, agent_run),
      method: :post,
      class: kb_btn_secondary_sm,
      form: { data: { turbo_confirm: approval_copy.reject_confirm } } %>
  </div>
</div>
