<div id="messages" class="nyoy-chat-messages space-y-3" data-controller="chat-stream" data-chat-stream-chat-id-value="<%= chat.id %>">
  <% chat.messages.order(:id).each do |message| %>
    <%= render message %>
  <% end %>
  <div id="agent_run_progress">
    <%= AgentGraph::ProgressBroadcaster.render_for_run(local_assigns[:running_agent_run]) if local_assigns[:running_agent_run] %>
  </div>
</div>
