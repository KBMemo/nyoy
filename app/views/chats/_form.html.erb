<%= form_with(
  model: chat,
  url: chats_path,
  class: "space-y-4",
  html: {
    multipart: true,
    data: {
      controller: "source-image-preview chat-form dialog",
      action: 'keydown->chat-form#submitOnShortcut'
    }
  }
) do |form| %>
  <% if chat.errors.any? %>
    <div class="kb-alert kb-alert-danger">
      <ul class="list-disc pl-5">
        <% chat.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="kb-alert kb-alert-danger"><%= flash[:alert] %></div>
  <% end %>

  <div class="kb-card p-3" data-source-image-preview-target="display" hidden>
    <p class="text-sm font-medium kb-text-secondary mb-2">添付画像プレビュー</p>
    <figure>
      <img class="nyoy-source-preview max-h-48 rounded" alt="添付画像プレビュー" data-source-image-preview-target="image" hidden>
    </figure>
    <p class="mt-2 text-sm kb-text-muted" data-source-image-preview-target="hint">プレビューは画像選択後に表示されます。</p>
  </div>

  <% if @chat_model_groups.any? %>
    <div>
      <%= form.label :model, "モデル", class: "#{kb_label} mb-1" %>
      <%= form.select :model,
          grouped_options_for_select(@chat_model_groups, @selected_model || default_chat_model_id),
          {},
          class: kb_field_input_classes %>
    </div>
  <% end %>

  <div>
    <div class="mb-1 flex items-center justify-between gap-2">
      <%= form.label :prompt, "最初のメッセージ", class: kb_label %>
      <button type="button" class="nyoy-chat-settings-btn" data-action="dialog#open" aria-label="チャット設定" title="チャット設定">
        <svg class="nyoy-chat-settings-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
      </button>
    </div>
    <%= form.text_area :prompt, rows: 4, class: kb_field_input_classes, placeholder: "何でも聞いてください（画像のみでも開始できます）", autofocus: true %>
  </div>

  <div>
    <%= form.label :attachments, "画像（任意）", class: "#{kb_label} mb-1" %>
    <%= form.file_field :attachments, accept: "image/jpeg,image/png,image/webp,image/gif", class: kb_field_input_classes, data: { action: "change->source-image-preview#preview", source_image_preview_target: "input" } %>
    <p class="mt-1 text-sm kb-text-muted">Ctrl+Enter で送信。JPEG / PNG / WebP / GIF。画像解析は必要なときだけ Chat がツールで行います。</p>
  </div>

  <div>
    <%= form.submit "チャットを開始", class: kb_btn_primary_sm %>
  </div>

  <%= render "chats/new_chat_settings_dialog", form: form %>
<% end %>
