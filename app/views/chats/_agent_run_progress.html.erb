<div
  id="agent_run_progress_panel"
  class="nyoy-agent-run-progress"
  role="status"
  aria-live="polite"
  data-node-started-at="<%= node_started_at %>"
  <% if run_started_at.present? %>data-run-started-at="<%= run_started_at %>"<% end %>
>
  <span class="nyoy-agent-run-progress-dot" aria-hidden="true"></span>
  <div class="nyoy-agent-run-progress-body">
    <span class="nyoy-agent-run-progress-label"><%= label %></span>
    <span class="nyoy-agent-run-progress-meta">
      <% if model_name.present? %>
        <span class="nyoy-agent-run-progress-model"><%= model_name %></span>
      <% end %>
      <span class="nyoy-agent-run-progress-elapsed" data-agent-run-progress-elapsed>0秒</span>
      <% if run_started_at.present? %>
        <span class="nyoy-agent-run-progress-run-elapsed" data-agent-run-progress-run-elapsed></span>
      <% end %>
    </span>
    <div id="agent_run_progress_prompts_section" class="nyoy-agent-run-progress-prompts-section hidden">
      <details class="nyoy-chat-message-thinking-details" open>
        <summary class="nyoy-chat-message-thinking-summary">システムプロンプト</summary>
        <pre id="agent_run_progress_system_prompt" class="nyoy-chat-message-thinking nyoy-agent-run-progress-prompt"></pre>
      </details>
      <details class="nyoy-chat-message-thinking-details nyoy-agent-run-progress-user-prompt-details hidden">
        <summary class="nyoy-chat-message-thinking-summary">ユーザープロンプト</summary>
        <pre id="agent_run_progress_user_prompt" class="nyoy-chat-message-thinking nyoy-agent-run-progress-prompt"></pre>
      </details>
    </div>
    <div id="agent_run_progress_thinking_section" class="nyoy-agent-run-progress-thinking-section hidden">
      <details class="nyoy-chat-message-thinking-details" open>
        <summary class="nyoy-chat-message-thinking-summary">思考</summary>
        <pre
          id="agent_run_progress_thinking"
          class="nyoy-chat-message-thinking nyoy-agent-run-progress-thinking"
          data-controller="thinking-auto-scroll"
        ></pre>
      </details>
    </div>
  </div>
</div>
