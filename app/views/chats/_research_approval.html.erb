<% draft = agent_run.state["draft"].to_s %>
<% thinking = agent_run.state["draft_thinking"].to_s %>
<% replan_count = agent_run.state["replan_count"].to_i %>
<% replans_remaining = [ AgentGraph::Nodes::AwaitApproval::MAX_REPLANS - replan_count, 0 ].max %>
<div class="nyoy-research-approval kb-card p-4 mt-4" id="research_approval_panel" data-agent-run-id="<%= agent_run.id %>">
  <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
    <div>
      <h2 class="text-base font-semibold kb-text-primary">調査ドラフトの確認</h2>
      <p class="mt-1 text-sm kb-text-secondary">内容を確認してからチャットへ反映してください。</p>
      <% if replan_count.positive? %>
        <p class="mt-1 text-sm kb-text-muted">やり直し <%= replan_count %> 回目（残り <%= replans_remaining %> 回）</p>
      <% elsif replans_remaining.positive? %>
        <p class="mt-1 text-sm kb-text-muted">却下すると調査をやり直します（残り <%= replans_remaining %> 回）</p>
      <% end %>
    </div>
    <span class="text-xs kb-text-muted">Research Graph #<%= agent_run.id %></span>
  </div>

  <% if thinking.present? %>
    <details class="nyoy-chat-message-thinking-details mb-3" open>
      <summary class="nyoy-chat-message-thinking-summary">思考</summary>
      <pre class="nyoy-chat-message-thinking"><%= thinking %></pre>
    </details>
  <% end %>

  <% if agent_run.state["draft_truncated"] == true %>
    <div class="kb-alert kb-alert-danger nyoy-chat-message-truncated-note mb-3" role="alert">
      <strong>応答は途中で打ち切られました。</strong>
      <%= ChatTruncationAdvice.inline_html_for(chat) %>
    </div>
  <% end %>

  <div class="nyoy-research-approval-draft nyoy-chat-markdown mb-4">
    <%= render_chat_markdown(draft) %>
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <%= button_to "この内容で回答する",
      approve_chat_agent_run_path(chat, agent_run),
      method: :post,
      class: kb_btn_primary_sm %>
    <% if replans_remaining.positive? %>
      <%= button_to "却下してやり直す",
        reject_chat_agent_run_path(chat, agent_run),
        method: :post,
        class: kb_btn_secondary_sm,
        form: { data: { turbo_confirm: "このドラフトを却下して調査をやり直しますか？（残り #{replans_remaining} 回）" } } %>
    <% else %>
      <%= button_to "却下して終了",
        reject_chat_agent_run_path(chat, agent_run),
        method: :post,
        class: kb_btn_secondary_sm,
        form: { data: { turbo_confirm: "このドラフトを却下して調査を終了しますか？" } } %>
    <% end %>
  </div>
</div>
