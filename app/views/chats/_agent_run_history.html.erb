<% if show_agent_run_history %>
  <section class="kb-card p-4 mt-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="<%= kb_section_title %>">AgentRun</h2>
        <p class="mt-1 text-sm kb-text-secondary">直近の Graph 実行履歴です。</p>
      </div>
    </div>
    <% if recent_agent_runs.any? %>
      <div class="mt-3 space-y-2">
        <% recent_agent_runs.each do |run| %>
          <div class="flex flex-wrap items-start justify-between gap-3 text-sm">
            <div>
              <span class="kb-text-secondary">
                #<%= run.id %>
                <span class="kb-text-primary"><%= run.graph_name %></span>
                / <%= run.status %>
                <% if run.current_node.present? %>
                  / <%= run.current_node %>
                <% end %>
              </span>
              <% if run.retry_run? %>
                <p class="mt-1 text-xs kb-text-secondary">
                  <% if (source_run = run.retry_source_run) %>
                    retry of <%= link_to "##{source_run.id}", chat_agent_run_path(chat, source_run), class: "kb-chrome-link" %>
                    <% if run.state["retry_from_checkpoint_id"].present? %>
                      / checkpoint #<%= run.state["retry_from_checkpoint_id"] %>
                    <% end %>
                    <% if run.state["retry_from_node"].present? %>
                      / from <%= run.state["retry_from_node"] %>
                    <% end %>
                  <% else %>
                    <%= run.retry_source_summary %>
                  <% end %>
                </p>
              <% end %>
              <% if run.failed? %>
                <p class="mt-1 text-xs kb-text-secondary"><%= run.recovery_summary %></p>
                <% if run.recovery_error_summary.present? %>
                  <p class="mt-1 text-xs text-red-600 dark:text-red-400"><%= run.recovery_error_summary %></p>
                <% end %>
              <% end %>
            </div>
            <%= link_to "詳細", chat_agent_run_path(chat, run), class: "kb-chrome-link text-sm" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-sm kb-text-secondary">
        Graph 実行履歴はありません。画像説明のみの応答は通常チャットとして処理されています。
      </p>
    <% end %>
  </section>
<% end %>
