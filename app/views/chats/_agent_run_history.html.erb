<% if show_agent_run_history %>
  <section class="kb-card p-4 mt-4">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="<%= kb_section_title %>">AgentRun</h2>
        <p class="mt-1 text-sm kb-text-secondary">直近の Graph 実行履歴です。</p>
      </div>
    </div>
    <% if recent_agent_runs.any? %>
      <div class="mt-3 space-y-2">
        <% recent_agent_runs.each do |run| %>
          <div class="flex flex-wrap items-center justify-between gap-3 text-sm">
            <span class="kb-text-secondary">
              #<%= run.id %>
              <span class="kb-text-primary"><%= run.graph_name %></span>
              / <%= run.status %>
              <% if run.current_node.present? %>
                / <%= run.current_node %>
              <% end %>
            </span>
            <%= link_to "詳細", chat_agent_run_path(chat, run), class: "kb-chrome-link text-sm" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-3 text-sm kb-text-secondary">
        Graph 実行履歴はありません。画像説明のみの応答は通常チャットとして処理されています。
      </p>
    <% end %>
  </section>
<% end %>
