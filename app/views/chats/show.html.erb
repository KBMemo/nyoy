<%= turbo_stream_from "chat_#{@chat.id}" %>

<% content_for :title, "チャット ##{@chat.id}" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="<%= kb_page_title %>">チャット</h1>
    <p class="mt-1 text-sm kb-text-secondary">
      モデル: <strong><%= @chat.model&.name || default_model_display_name %></strong>
      <% stats = chat_context_stats(@chat) %>
      <% if chat_context_turn_limit.positive? %>
        <span class="kb-text-muted">（直近 <%= chat_context_turn_limit %> ターンを送信<% if stats.summarized_turns.positive? %>、<%= stats.summarized_turns %> ターン要約<% end %>）</span>
      <% end %>
      <% if stats.warning %>
        <span class="text-amber-600 dark:text-amber-400"> — 推定 <%= number_with_delimiter(stats.estimated_tokens) %> / <%= number_with_delimiter(stats.context_window) %> tokens（<%= number_to_percentage(stats.ratio * 100, precision: 0) %>）</span>
      <% else %>
        <span class="kb-text-muted"> — 推定 <%= number_with_delimiter(stats.estimated_tokens) %> tokens</span>
      <% end %>
      <% rag = memo_rag_status %>
      <% if rag.enabled %>
        <span class="kb-text-muted"> — メモ RAG <%= number_with_delimiter(rag.chunk_count) %> チャンク<% if rag.last_synced_at %>（最終更新 <%= l(rag.last_synced_at, format: :short) %>）<% end %></span>
      <% end %>
    </p>
  </div>
  <%= link_to "一覧へ", chats_path, class: "kb-chrome-link text-sm" %>
</div>

<div id="messages" class="nyoy-chat-messages space-y-3">
  <% @chat.messages.where.not(id: nil).each do |message| %>
    <%= render message %>
  <% end %>
</div>

<div class="kb-card p-4 mt-6">
  <%= render "messages/form", chat: @chat, message: @message %>
</div>
