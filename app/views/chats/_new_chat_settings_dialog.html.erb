<% llm_settings = local_assigns.fetch(:chat_llm_settings, @chat_llm_settings) %>
<% presets = local_assigns.fetch(:llm_sampling_presets, @llm_sampling_presets) || LlmSamplingPreset.enabled.ordered %>
<dialog id="new_chat_settings_dialog" class="nyoy-dialog" data-dialog-target="panel" data-action="click->dialog#backdropClose">
  <div class="nyoy-dialog-panel" role="document">
    <header class="nyoy-dialog-header">
      <div>
        <h2 class="nyoy-dialog-title">サンプリング設定</h2>
        <p class="nyoy-dialog-description">
          このチャット開始時のモデルパラメータです。空欄は接続プロファイル → アプリ既定の順で補完されます。
          <%= link_to "既定の変更", edit_app_settings_path, class: "kb-chrome-link" %>
        </p>
      </div>
      <button type="button" class="kb-chrome-btn-secondary kb-btn-sm" data-action="dialog#close" aria-label="閉じる">閉じる</button>
    </header>

    <div class="nyoy-dialog-body space-y-4" data-controller="prompt-conversion-settings">
      <section class="nyoy-dialog-section">
        <h3 class="nyoy-dialog-section-title">モデルパラメータ</h3>
        <p class="nyoy-dialog-section-description">推奨プリセットを適用するか、各パラメータを直接指定できます。max_tokens は llama-server のコンテキスト（-c / --ctx-size）より大きくできません。</p>

        <div class="mt-3 space-y-2">
          <label class="<%= kb_label %> mb-1" for="new_chat_sampling_preset_select">推奨プリセット</label>
          <div class="flex flex-wrap items-center gap-2">
            <select id="new_chat_sampling_preset_select" class="kb-input kb-field-input" data-prompt-conversion-settings-target="presetSelect">
              <option value="">選択してください</option>
              <% presets.each do |preset| %>
                <option value="<%= preset.id %>" data-params="<%= ERB::Util.html_escape(preset.prompt_conversion_attrs.to_json) %>"><%= preset.name %></option>
              <% end %>
            </select>
            <button type="button" class="<%= kb_btn_secondary_sm %>" data-action="prompt-conversion-settings#applyPreset">適用</button>
          </div>
          <p class="text-sm kb-status-success hidden" data-prompt-conversion-settings-target="status"></p>
          <p class="text-sm text-red-600 hidden" data-prompt-conversion-settings-target="error"></p>
        </div>

        <div class="mt-3 flex flex-wrap items-end gap-x-3 gap-y-2">
          <% LlmSamplingParams::KEYS.each do |key| %>
            <% if key == "reasoning_effort" %>
              <div class="w-24 shrink-0">
                <%= form.label key, key, class: "#{kb_label} mb-1 font-mono text-[10px] leading-tight" %>
                <%= form.select key,
                  options_for_select([["—", ""]] + LlmSamplingParams::REASONING_EFFORTS.map { |value| [value, value] }, llm_settings.reasoning_effort),
                  {},
                  name: "chat[#{key}]",
                  id: "chat_#{key}",
                  class: "#{kb_field_input_classes} w-24 max-w-24 font-mono text-xs px-1",
                  data: { prompt_conversion_settings_field: key } %>
              </div>
              <% next %>
            <% end %>
            <% inputmode = LlmSamplingParams::FLOAT_KEYS.include?(key) ? "decimal" : "numeric" %>
            <div class="w-16 shrink-0">
              <%= form.label key, key, class: "#{kb_label} mb-1 font-mono text-[10px] leading-tight" %>
              <%= form.text_field key,
                value: llm_settings.public_send(key),
                name: "chat[#{key}]",
                id: "chat_#{key}",
                inputmode: inputmode,
                autocomplete: "off",
                class: "#{kb_field_input_classes} w-16 max-w-16 font-mono text-xs px-1",
                placeholder: "—",
                data: { prompt_conversion_settings_field: key } %>
            </div>
          <% end %>
        </div>
      </section>

      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="<%= kb_btn_secondary_sm %>" data-action="dialog#close">完了</button>
      </div>
    </div>
  </div>
</dialog>
