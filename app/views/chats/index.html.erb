<% content_for :title, "チャット一覧" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="<%= kb_page_title %>">チャット</h1>
    <p class="mt-1 text-sm kb-text-secondary">llama-server につながった会話型チャットです。</p>
  </div>
  <%= link_to "新規チャット", new_chat_path, class: kb_btn_primary_sm %>
</div>

<% if @chats.any? %>
  <% message_counts = Chat.message_counts_for(@chats) %>
  <% previews = Chat.list_previews_for(@chats) %>
  <div class="space-y-4" id="chats">
    <% @chats.each do |chat| %>
      <% preview = tool_message_preview(previews[chat.id], length: 200) %>
      <div class="kb-card p-4">
        <div class="nyoy-chat-list-card">
          <div class="nyoy-chat-list-card-main">
            <%= render chat, message_count: message_counts[chat.id] || 0 %>
            <div class="mt-3 flex flex-wrap items-center gap-3">
              <%= link_to "開く", chat, class: kb_btn_primary_sm %>
              <%= button_to "削除", chat, method: :delete, class: "kb-chrome-link text-sm nyoy-inline-delete-btn", form: { class: "inline", data: { turbo_confirm: "このチャットを削除しますか？" } } %>
            </div>
          </div>
          <% if preview.present? %>
            <p class="nyoy-chat-list-card-preview"><%= preview %></p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="kb-text-secondary">チャットはまだありません。</p>
<% end %>


<div class="mt-6">
  <%= link_to "新しいチャット", new_chat_path, class: kb_btn_primary_sm %>
</div>
