.mb-6.flex.flex-wrap.items-start.justify-between.gap-3
  div
    h1.text-xl.font-semibold.kb-text-primary = @prompt_skill.name
    - if @prompt_skill.default?
      span.kb-badge.kb-badge-muted.mt-2 default

.kb-card.p-4
  pre.nyoy-monospace = @prompt_skill.body

.flex.flex-wrap.items-center.gap-3.mt-6
  = link_to "編集", edit_prompt_skill_path(@prompt_skill), class: kb_btn_primary_sm
  = link_to "一覧へ", prompt_skills_path, class: "kb-chrome-link text-sm"
