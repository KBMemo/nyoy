<%= form_with model: prompt_skill, class: "form" do |form| %>
  <% if prompt_skill.errors.any? %>
    <div class="errors">
      <ul>
        <% prompt_skill.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name, "名前" %>
    <%= form.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= form.label :body, "スキル本文 (system prompt)" %>
    <%= form.text_area :body, rows: 24, required: true, class: "monospace" %>
  </div>

  <div class="field checkbox">
    <%= form.check_box :default %>
    <%= form.label :default, "デフォルトスキルにする" %>
  </div>

  <div class="actions">
    <%= form.submit class: "button" %>
  </div>
<% end %>
