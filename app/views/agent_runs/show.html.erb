<% content_for :title, "AgentRun ##{@agent_run.id}" %>

<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="<%= kb_page_title %>">AgentRun #<%= @agent_run.id %></h1>
    <p class="mt-1 text-sm kb-text-secondary">
      <%= @agent_run.graph_name %> /
      <%= @agent_run.status %>
      <% if @agent_run.current_node.present? %>
        / current: <%= @agent_run.current_node %>
      <% end %>
    </p>
  </div>
  <%= link_to "チャットへ戻る", chat_path(@chat), class: "kb-chrome-link text-sm" %>
</div>

<section class="kb-card p-4">
  <h2 class="<%= kb_section_title %>">実行概要</h2>
  <dl class="mt-4 grid gap-3 sm:grid-cols-2">
    <div>
      <dt class="text-xs kb-text-muted">Graph</dt>
      <dd class="text-sm kb-text-primary"><%= @agent_run.graph_name %></dd>
    </div>
    <div>
      <dt class="text-xs kb-text-muted">Status</dt>
      <dd class="text-sm kb-text-primary"><%= @agent_run.status %></dd>
    </div>
    <div>
      <dt class="text-xs kb-text-muted">Current Node</dt>
      <dd class="text-sm kb-text-primary"><%= @agent_run.current_node.presence || "なし" %></dd>
    </div>
    <div>
      <dt class="text-xs kb-text-muted">Chat</dt>
      <dd class="text-sm kb-text-primary">#<%= @chat.id %></dd>
    </div>
    <% if @agent_run.retry_run? %>
      <div>
        <dt class="text-xs kb-text-muted">Retry Source</dt>
        <dd class="text-sm kb-text-primary">
          <% if (source_run = @agent_run.retry_source_run) %>
            <%= link_to "AgentRun ##{source_run.id}", chat_agent_run_path(@chat, source_run), class: "kb-chrome-link" %>
            <% if @agent_run.state["retry_from_checkpoint_id"].present? %>
              / checkpoint #<%= @agent_run.state["retry_from_checkpoint_id"] %>
            <% end %>
            <% if @agent_run.state["retry_from_node"].present? %>
              / from <%= @agent_run.state["retry_from_node"] %>
            <% end %>
          <% else %>
            <%= @agent_run.retry_source_summary %>
          <% end %>
        </dd>
      </div>
    <% end %>
    <div>
      <dt class="text-xs kb-text-muted">Started</dt>
      <dd class="text-sm kb-text-primary"><%= @agent_run.started_at ? l(@agent_run.started_at, format: :long) : "未開始" %></dd>
    </div>
    <div>
      <dt class="text-xs kb-text-muted">Finished</dt>
      <dd class="text-sm kb-text-primary"><%= @agent_run.finished_at ? l(@agent_run.finished_at, format: :long) : "未完了" %></dd>
    </div>
  </dl>

  <% if @agent_run.error_message.present? %>
    <div class="kb-alert kb-alert-danger mt-4" role="alert">
      <%= @agent_run.error_message %>
    </div>
  <% end %>
</section>

<% if @agent_run.failed? %>
  <section class="kb-card p-4 mt-4">
    <h2 class="<%= kb_section_title %>">復旧確認</h2>
    <p class="mt-1 text-sm kb-text-secondary">
      自動 retry はまだ行いません。失敗位置と再実行候補を確認するための情報です。
    </p>
    <% if @failed_node_run&.error_message.present? %>
      <div class="kb-alert kb-alert-danger mt-4" role="alert">
        <%= @failed_node_run.error_message %>
      </div>
    <% end %>
    <dl class="mt-4 grid gap-3 sm:grid-cols-2">
      <div>
        <dt class="text-xs kb-text-muted">Failed Node</dt>
        <dd class="text-sm kb-text-primary">
          <% if @failed_node_run %>
            <%= link_to @failed_node_run.node_name, "#agent_node_run_#{@failed_node_run.id}", class: "kb-chrome-link" %>
          <% else %>
            <%= @agent_run.current_node.presence || "不明" %>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs kb-text-muted">Last Checkpoint</dt>
        <dd class="text-sm kb-text-primary">
          <% if @latest_checkpoint %>
            <%= link_to "##{@latest_checkpoint.id} #{@latest_checkpoint.node_name}", "#agent_checkpoint_#{@latest_checkpoint.id}", class: "kb-chrome-link" %>
          <% else %>
            なし
          <% end %>
        </dd>
      </div>
    </dl>
    <% if @retry_plan %>
      <div class="mt-4 rounded border p-3 text-sm">
        <h3 class="text-xs kb-text-muted">Retry Dry-run</h3>
        <p class="mt-1 kb-text-secondary">
          <%= @retry_plan.retryable ? "retry 候補" : "retry 保留" %>: <%= @retry_plan.reason %>
        </p>
        <% if @retry_plan.checkpoint %>
          <p class="mt-1 kb-text-secondary">
            起点 checkpoint:
            <%= link_to "##{@retry_plan.checkpoint.id} #{@retry_plan.checkpoint.node_name}", "#agent_checkpoint_#{@retry_plan.checkpoint.id}", class: "kb-chrome-link" %>
          </p>
        <% end %>
        <% if @retry_plan.next_node.present? %>
          <p class="mt-1 kb-text-secondary">次 node: <%= @retry_plan.next_node %></p>
        <% end %>
        <% if @retry_plan.retryable %>
          <div class="mt-3">
            <% if @chat.responding? %>
              <span class="kb-chrome-btn-secondary kb-btn-sm opacity-50" aria-disabled="true">別の応答が実行中です</span>
            <% else %>
              <%= button_to "複製 run で retry",
                retry_chat_agent_run_path(@chat, @agent_run),
                method: :post,
                class: kb_btn_primary_sm,
                form: { data: { turbo_confirm: "この checkpoint から複製 run を作成して retry しますか？" } } %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
    <ul class="mt-3 space-y-1 text-sm kb-text-secondary">
      <% @recovery_candidates.each do |candidate| %>
        <li><%= candidate %></li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="kb-card p-4 mt-4">
  <h2 class="<%= kb_section_title %>">Node 履歴</h2>
  <% if @node_runs.any? %>
    <div class="mt-4 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-left kb-text-muted">
          <tr>
            <th class="py-2 pr-4">#</th>
            <th class="py-2 pr-4">Node</th>
            <th class="py-2 pr-4">Status</th>
            <th class="py-2 pr-4">Elapsed</th>
            <th class="py-2 pr-4">Started</th>
            <th class="py-2 pr-4">Finished</th>
            <th class="py-2 pr-4">Summary</th>
          </tr>
        </thead>
        <tbody>
          <% @node_runs.each do |node_run| %>
            <% failed_node_detail_open = @agent_run.failed? && @failed_node_run&.id == node_run.id %>
            <tr id="agent_node_run_<%= node_run.id %>" class="nyoy-agent-node-row">
              <td class="py-2 pr-4 kb-text-muted"><%= node_run.id %></td>
              <td class="py-2 pr-4"><%= node_run.node_name %></td>
              <td class="py-2 pr-4"><%= node_run.status %></td>
              <td class="py-2 pr-4"><%= node_run.elapsed_seconds ? nyoy_format_duration(node_run.elapsed_seconds) : "-" %></td>
              <td class="py-2 pr-4"><%= node_run.started_at ? l(node_run.started_at, format: :short) : "-" %></td>
              <td class="py-2 pr-4"><%= node_run.finished_at ? l(node_run.finished_at, format: :short) : "-" %></td>
              <td class="py-2 pr-4 kb-text-secondary">
                <%= node_run.output_summary.join(" / ") %>
              </td>
            </tr>
            <tr class="nyoy-agent-node-detail-row">
              <td colspan="7" class="pb-3">
                <details class="rounded border p-3" <%= "open" if failed_node_detail_open %>>
                  <summary class="kb-chrome-link text-sm">
                    #<%= node_run.id %> <%= node_run.node_name %> の snapshot
                  </summary>
                  <div class="mt-3">
                    <% if node_run.error_message.present? %>
                      <div class="kb-alert kb-alert-danger mb-3" role="alert">
                        <%= node_run.error_message %>
                      </div>
                    <% end %>
                    <div class="grid gap-3 lg:grid-cols-2">
                      <div>
                        <h3 class="text-xs kb-text-muted">Input</h3>
                        <pre class="mt-1 text-xs whitespace-pre-wrap nyoy-monospace"><%= JSON.pretty_generate(node_run.input_snapshot || {}) %></pre>
                      </div>
                      <div>
                        <h3 class="text-xs kb-text-muted">Output</h3>
                        <pre class="mt-1 text-xs whitespace-pre-wrap nyoy-monospace"><%= JSON.pretty_generate(node_run.output_snapshot || {}) %></pre>
                      </div>
                    </div>
                  </div>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="mt-3 text-sm kb-text-secondary">Node 実行履歴はまだありません。</p>
  <% end %>
</section>

<section class="kb-card p-4 mt-4">
  <h2 class="<%= kb_section_title %>">State</h2>
  <p class="mt-1 text-sm kb-text-secondary"><%= @agent_run.state_summary %></p>
  <details class="mt-3">
    <summary class="kb-chrome-link text-sm">JSON を表示</summary>
    <pre class="mt-3 text-xs whitespace-pre-wrap nyoy-monospace"><%= JSON.pretty_generate(@agent_run.state || {}) %></pre>
  </details>
</section>

<section class="kb-card p-4 mt-4">
  <h2 class="<%= kb_section_title %>">Checkpoint</h2>
  <p class="mt-1 text-sm kb-text-secondary"><%= @checkpoints.count %> 件</p>
  <% if @checkpoints.any? %>
    <div class="mt-3 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="text-left kb-text-muted">
          <tr>
            <th class="py-2 pr-4">#</th>
            <th class="py-2 pr-4">Node</th>
            <th class="py-2 pr-4">Created</th>
            <th class="py-2 pr-4">Summary</th>
          </tr>
        </thead>
        <tbody>
          <% @checkpoints.each do |checkpoint| %>
            <% latest_checkpoint_detail_open = @agent_run.failed? && @latest_checkpoint&.id == checkpoint.id %>
            <tr id="agent_checkpoint_<%= checkpoint.id %>" class="nyoy-agent-node-row">
              <td class="py-2 pr-4 kb-text-muted"><%= checkpoint.id %></td>
              <td class="py-2 pr-4"><%= checkpoint.node_name %></td>
              <td class="py-2 pr-4"><%= l(checkpoint.created_at, format: :short) %></td>
              <td class="py-2 pr-4 kb-text-secondary"><%= checkpoint.state_summary %></td>
            </tr>
            <tr class="nyoy-agent-node-detail-row">
              <td colspan="4" class="pb-3">
                <details class="rounded border p-3" <%= "open" if latest_checkpoint_detail_open %>>
                  <summary class="kb-chrome-link text-sm">
                    #<%= checkpoint.id %> <%= checkpoint.node_name %> の state
                  </summary>
                  <pre class="mt-3 text-xs whitespace-pre-wrap nyoy-monospace"><%= JSON.pretty_generate(checkpoint.state || {}) %></pre>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
