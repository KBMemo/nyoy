<h1>イラストを生成</h1>
<p class="lead">メモや文章だけ入力してください。プロンプトと生成パラメータは自動で決定します。</p>

<%= form_with model: @memo_illustration, class: "form" do |form| %>
  <% if @memo_illustration.errors.any? %>
    <div class="errors">
      <ul>
        <% @memo_illustration.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :body, "文章" %>
    <%= form.text_area :body, rows: 8, required: true, placeholder: "例: 今日の打ち合わせメモ。窓際のカフェでノートPCを開き、コーヒーを飲みながら考え込んでいる。落ち着いた雰囲気。" %>
  </div>

  <% if @prompt_skills.any? %>
    <div class="field">
      <%= form.label :prompt_skill_id, "プロンプトスキル" %>
      <%= form.collection_select :prompt_skill_id, @prompt_skills, :id, :name,
            { selected: @prompt_skills.find(&:default?)&.id || @prompt_skills.first.id },
            { required: true } %>
    </div>
  <% else %>
    <div class="errors">
      <p>プロンプトスキルが未登録です。<%= link_to "スキルを作成", new_prompt_skill_path %>してください。</p>
    </div>
  <% end %>

  <div class="actions">
    <%= form.submit "生成する", class: "button", disabled: @prompt_skills.empty? %>
    <%= link_to "戻る", root_path %>
  </div>
<% end %>
