<h1>メモイラスト</h1>
<p class="lead">メモや文章から、キーワードを抽出してイラストを生成します。</p>

<% if @current_sd_model.present? %>
  <p class="meta">現在の SD モデル: <strong><%= @current_sd_model %></strong></p>
<% end %>

<p><%= link_to "新しいイラストを生成", new_memo_illustration_path, class: "button" %></p>

<% if @memo_illustrations.any? %>
  <section class="card-list">
    <% @memo_illustrations.each do |illustration| %>
      <%= link_to memo_illustration_path(illustration), class: "card" do %>
        <div class="card-header">
          <span class="status status-<%= illustration.status %>"><%= illustration.status %></span>
          <span class="model"><%= illustration.sd_model %></span>
        </div>
        <p class="prompt"><%= truncate(illustration.body, length: 80) %></p>
        <% if illustration.image.attached? %>
          <%= image_tag illustration.image.variant(resize_to_limit: [256, 256]), alt: illustration.body %>
        <% end %>
      <% end %>
    <% end %>
  </section>
<% else %>
  <p class="empty">まだ生成履歴がありません。</p>
<% end %>
