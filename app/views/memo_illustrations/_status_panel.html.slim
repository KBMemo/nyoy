= turbo_frame_tag dom_id(memo_illustration, :status) do
  div.mb-6.flex.flex-wrap.items-start.justify-between.gap-3
    div
      h1 class=kb_page_title 生成結果
      p.mt-1.text-sm.kb-text-secondary
        span class="nyoy-status nyoy-status-#{memo_illustration.status}" = memo_illustration.status_label
        - if memo_illustration.sd_model.present?
          |  · #{memo_illustration.sd_model}
        - if memo_illustration.style_label.present?
          |  · スタイル: #{memo_illustration.style_label}
        = render "shared/generation_phase_timing", record: memo_illustration

  .kb-card.p-4
    h2 class=kb_section_title 入力した文章
    p.mt-2.text-sm.kb-text-secondary = simple_format(memo_illustration.body)

    - if memo_illustration.positive_prompt.present?
      h2.mt-6 class=kb_section_title Positive Prompt
      p.mt-2.text-sm.nyoy-monospace = memo_illustration.positive_prompt

    - if memo_illustration.resolved_negative_prompt.present?
      h2.mt-6 class=kb_section_title ネガティブプロンプト
      p.mt-2.text-sm.nyoy-monospace = memo_illustration.resolved_negative_prompt

    - if memo_illustration.rag_source_chunks.any?
      h2.mt-6 class=kb_section_title 参照ナレッジ
      ul.mt-2.list-disc.pl-5.text-sm.kb-text-secondary
        - memo_illustration.rag_source_chunks.each do |chunk|
          li = link_to chunk.title, chunk, class: "kb-chrome-link"

    - if memo_illustration.positive_prompt.present?
      h2.mt-6 class=kb_section_title 生成パラメータ
      dl.mt-2.nyoy-settings-list
        dt サイズ
        dd = "#{memo_illustration.width}×#{memo_illustration.height}"
        dt Steps / CFG
        dd = "#{memo_illustration.steps} / #{memo_illustration.cfg_scale}"
        dt Seed
        dd = nyoy_format_seed(memo_illustration.seed)

    - if memo_illustration.error_message.present?
      .kb-alert.kb-alert-danger.mt-4
        p = memo_illustration.error_message

    - if memo_illustration.in_progress?
      p.mt-4.text-sm.kb-text-muted 生成中です… 状態は自動更新されます。

    - if memo_illustration.image.attached?
      figure.nyoy-result-image.mt-4
        = nyoy_blob_image_tag memo_illustration.image, alt: memo_illustration.body

  .flex.flex-wrap.items-center.gap-3.mt-6
    = link_to "新しいイラスト", new_memo_illustration_path, class: kb_btn_primary_sm, data: { turbo_frame: "_top" }
    = link_to "一覧へ", root_path, class: "kb-chrome-link text-sm", data: { turbo_frame: "_top" }
