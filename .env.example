# Copy to env.development for local development (loaded by bin/dev).
# bin/dev の既定 Rails ポートは 3009（turedure 3000 / tsuzura 3008 と被らない）。
# Vite dev server の既定は 3040（VITE_RUBY_PORT）。
# PORT=3010
# VITE_RUBY_PORT=3042
# SDCPP_DEFAULT_MODELS is used only when SDCPP_SWITCHD_TOKEN is not set.
#
# PostgreSQL 接続先は config/database.yml（bowmore.artif.org:5432）を参照。
# ユーザー名・パスワードは bin/rails credentials:edit で database: 以下に設定してください。

EMBEDDINGS_URL=http://balvenie:10020
EMBEDDINGS_MODEL=lfm2.5-embedding-350m-q4-k-m
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_CHARS=1000
LLAMA_JSON_SCHEMA=true
LLAMA_READ_TIMEOUT=300
# Chat の KV cache 再利用。スロット数は通常 GET /props の total_slots から取得。
# LLAMA_SLOT_COUNT は props 取得失敗時のフォールバック（0 で無効）。
# LLAMA_SLOT_COUNT=4
LLAMA_CACHE_PROMPT=true

LLAMA_CPP_URL=http://balvenie:10010
LLAMA_SWITCHD_URL=http://balvenie:11335
LLAMA_SWITCHD_TOKEN=
LLAMA_MODEL=gemma-4-e4b-it-qat-ud-q4-k-xl
GPT_OSS_MODEL=gpt-oss
# GPT_OSS_LLAMA_CPP_URL=http://balvenie:10012

# OpenAI（ChatGPT）— 接続画面でも API キーを設定できます
# OPENAI_API_URL=https://api.openai.com
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_CHAT_API_KEY=sk-...

# llama-server 互換 API 用のダミーキー（ローカル LLM）
OPENAI_API_KEY=local
VISION_LLAMA_CPP_URL=http://balvenie:10021
VISION_LLAMA_MODEL=qwen3vl-4b-instruct-q4-k-m
SDCPP_SERVER_URL=http://balvenie:11234
SDCPP_SWITCHD_URL=http://balvenie:11334
SDCPP_SWITCHD_TOKEN=
SDCPP_DEFAULT_MODELS=flat2d,anythingv5,dreamshaper8,pony-v6,illustrious_pencil-XL,krea2

# 徒然（KBMemo）Chat メモツール
KBMEMO_URL=https://kbmemo.net
# KBMEMO_API_TOKEN=kbmemo_...

# 葛籠（KBMemo Media）Chat 画像アーカイブ
TSUZURA_URL=http://localhost:3008
# TSUZURA_API_TOKEN=tsuzura_...

# searfront Web 検索（Chat web_search。接続キー: searfront）
SEARFRONT_URL=http://bowmore:13000
# SEARFRONT_TOKEN=...
# 互換（非推奨）: SEARXNG_URL / SEARXNG_API_TOKEN でも読めます
# SEARXNG_URL=http://bowmore:13000
# SEARXNG_API_TOKEN=...

# readability-js-server（Chat fetch_url 本文抽出）
READABILITY_URL=http://bowmore:8030

# Chat に送る履歴（ユーザー発話単位）。0 で無制限。
CHAT_CONTEXT_TURNS=10

# メモ RAG（徒然メモのチャンク検索）
MEMO_RAG_ENABLED=true
# tool: recall_memos ツールを必要時に呼ぶ（毎ターン前処理なし） / inject: 毎ターン自動注入
MEMO_RAG_MODE=tool
# メインLLMのツール制限。restricted/read_only: 読み取り系のみ、all: write 系も許可、none: 無効。
MAIN_LLM_TOOL_MODE=restricted
# カンマ区切り allowlist。指定時は MAIN_LLM_TOOL_MODE より優先。
# MAIN_LLM_TOOL_ALLOWLIST=recall_memos,web_search,fetch_url
MEMO_RAG_TOP_K=5
MEMO_RAG_TOP_K_SIMPLE=3
MEMO_RAG_TOP_K_NORMAL=5
MEMO_RAG_TOP_K_COMPLEX=10
MEMO_RAG_MAX_CHARS=12000
MEMO_RAG_CHUNK_MAX_OUTPUT_CHARS=800
# MEMO_RAG_LLM_COMPRESS=true
MEMO_CHUNK_MAX_CHARS=1500
MEMO_INGEST_PAGE_LIMIT=100
# MEMO_RAG_WEBHOOK_ENABLED=true
# MEMO_RAG_WEBHOOK_SECRET=change-me

# 会話要約・トークン警告
CHAT_SUMMARY_ENABLED=true
CHAT_SUMMARY_MAX_CHARS=1200
# CHAT_SUMMARY_LLM=true
CHAT_SUMMARY_MAX_TOKENS=300
CHAT_CONTEXT_TOKEN_WARN_RATIO=0.75
CHAT_RESPONSE_TOKEN_RESERVE=2000
# UI（設定 → 既定モデル）未設定時のフォールバック
STYLE_PLAN_CONNECTION_KEY=llama_cpp
DEFAULT_CHAT_CONNECTION_KEY=llama_cpp
MEMO_RAG_MAX_TOKENS=1500

# AgentGraph role profile（AppSetting 未設定時のfallback）
# draft: evidence_pack（LLMなし） / llm（調査ドラフト用モデルを使用）
# AGENT_GRAPH_DRAFT_PROFILE=llm
# planner: deterministic（決定規則） / llm（調査計画用モデルを使用）
# AGENT_GRAPH_PLANNER_PROFILE=llm
# evidence_evaluator: heuristic（決定規則） / llm（取得済み根拠を追加判定）
# AGENT_GRAPH_EVIDENCE_EVALUATOR_PROFILE=llm
# final_answer: main（チャットモデル） / light（専用軽量モデル、失敗時main）
# AGENT_GRAPH_FINAL_ANSWER_PROFILE=light
# intent: deterministic（決定規則） / hybrid_llm（未判定時だけLLM調査判定）
# AGENT_GRAPH_INTENT_PROFILE=hybrid_llm
# vision: main（既定のvision service）
# AGENT_GRAPH_VISION_PROFILE=main
# memo_writer: deterministic（承認前のメモdraft整形）
# AGENT_GRAPH_MEMO_WRITER_PROFILE=deterministic

# Nyoy MCP（/mcp, bin/mcp-stdio）。未設定時は MCP 無効。
# MCP_API_TOKEN=
