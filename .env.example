# Copy to env.development for local development (loaded by bin/dev).
# SDCPP_DEFAULT_MODELS is used only when SDCPP_SWITCHD_TOKEN is not set.
#
# PostgreSQL 接続先は config/database.yml（bowmore.artif.org:5432）を参照。
# ユーザー名・パスワードは bin/rails credentials:edit で database: 以下に設定してください。

EMBEDDINGS_URL=http://balvenie:10020
EMBEDDINGS_MODEL=groonga/bge-m3-Q4_K_M-GGUF
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_CHARS=1000
LLAMA_JSON_SCHEMA=true
LLAMA_READ_TIMEOUT=300
# Chat の KV cache 再利用。スロット数は通常 GET /props の total_slots から取得。
# LLAMA_SLOT_COUNT は props 取得失敗時のフォールバック（0 で無効）。
# LLAMA_SLOT_COUNT=4
LLAMA_CACHE_PROMPT=true
# アイドル明けの cold start を抑えるため、チャット用 llama.cpp を定期 ping して常駐維持。
LLAMA_WARMUP_ENABLED=true
# 直近この秒数以内に会話があればウォームアップをスキップ（稼働中の slot キャッシュを保護）。
LLAMA_WARMUP_SKIP_RECENT_SECONDS=480
LLAMA_WARMUP_READ_TIMEOUT=60

LLAMA_CPP_URL=http://balvenie:10010
LLAMA_MODEL=gemma-4-12b-it-vision-mtp
GPT_OSS_MODEL=gpt-oss
# GPT_OSS_LLAMA_CPP_URL=http://balvenie:10012
OPENAI_API_KEY=local
VISION_LLAMA_CPP_URL=http://balvenie:10021
VISION_LLAMA_MODEL=qwen2.5-vl-3b
SDCPP_SERVER_URL=http://balvenie:11234
SDCPP_SWITCHD_URL=http://balvenie:11334
SDCPP_SWITCHD_TOKEN=
SDCPP_DEFAULT_MODELS=flat2d,anythingv5,dreamshaper8,pony-v6,illustrious_pencil-XL

# 徒然（KBMemo）Chat メモツール
KBMEMO_URL=https://kbmemo.net
# KBMEMO_API_TOKEN=kbmemo_...

# 葛籠（KBMemo Media）Chat 画像アーカイブ
TSUZURA_URL=http://localhost:3008
# TSUZURA_API_TOKEN=tsuzura_...

# SearXNG Web 検索（Chat web_search ツール）
SEARXNG_URL=http://bowmore.artif.org:8080
# SEARXNG_API_TOKEN=...

# readability-js-server（Chat fetch_url 本文抽出）
READABILITY_URL=http://bowmore:8030

# Chat に送る履歴（ユーザー発話単位）。0 で無制限。
CHAT_CONTEXT_TURNS=10

# メモ RAG（徒然メモのチャンク検索を Chat に自動注入）
MEMO_RAG_ENABLED=true
MEMO_RAG_TOP_K=5
MEMO_RAG_TOP_K_SIMPLE=3
MEMO_RAG_TOP_K_NORMAL=5
MEMO_RAG_TOP_K_COMPLEX=10
MEMO_RAG_MAX_CHARS=12000
MEMO_RAG_CHUNK_MAX_OUTPUT_CHARS=800
# MEMO_RAG_LLM_COMPRESS=true
MEMO_CHUNK_MAX_CHARS=1500
MEMO_INGEST_PAGE_LIMIT=100

# 会話要約・トークン警告
CHAT_SUMMARY_ENABLED=true
CHAT_SUMMARY_MAX_CHARS=1200
# CHAT_SUMMARY_LLM=true
CHAT_SUMMARY_MAX_TOKENS=300
CHAT_CONTEXT_TOKEN_WARN_RATIO=0.75
CHAT_RESPONSE_TOKEN_RESERVE=2000
STYLE_PLAN_CONNECTION_KEY=llama_cpp
MEMO_RAG_MAX_TOKENS=1500
